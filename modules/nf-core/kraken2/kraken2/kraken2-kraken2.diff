--- modules/nf-core/kraken2/kraken2/environment.yml
+++ modules/nf-core/kraken2/kraken2/environment.yml
@@ -4,6 +4,12 @@ channels:
   - conda-forge
   - bioconda
 dependencies:
-  - bioconda::kraken2=2.1.6
+  - bioconda::kraken2=2.17.2
   - coreutils=9.5
   - pigz=2.8
+  # The container base no longer ships these. The kraken2 wrapper decompresses
+  # .gz and .bz2 input through gzip and bzip2 (without them it classifies
+  # nothing and exits 0), and the daemon's clients queue on flock.
+  - conda-forge::bzip2=1.0.8
+  - conda-forge::gzip=1.14
+  - conda-forge::util-linux=2.42.4
