/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for testing the sylph-only fast path
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    The minimal test's reads (conf/test.config, included by the profile) through
    `--run_sylph --skip_kraken2 --skip_host_removal`: no alignment, no Kraken2,
    straight from trimming to sylph.
    The database is nf-core/taxprofiler's sylph test database. It is built from
    genomes in taxprofiler's own test data, not from SARS-CoV-2, so against these
    reads sylph is EXPECTED to find nothing - which is the point: it exercises
    the empty-result path, where a sample must come out as a column of zeros
    rather than failing the run or vanishing from the cohort tables. It was
    sketched with an older sylph than the 1.0.0 the pipeline runs; if 1.0.0
    refuses the format, this profile needs a fresh test database, not a code fix.
    Use as follows:
        nextflow run BioinfoIPBLN/reanatax -profile test_sylph,<docker/singularity> --outdir <OUTDIR>
----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Test profile: sylph-only fast path'
    config_profile_description = 'Minimal test reads through sylph alone, with no host alignment or Kraken2'

    run_sylph                  = true
    sylph_db                   = 'https://github.com/nf-core/test-datasets/raw/taxprofiler/data/database/sylph/testdb-sylph.syldb'
    skip_kraken2               = true
    skip_host_removal          = true
}
