/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    /*
    ------------------------------------------------------------------------
        Data retrieval
    ------------------------------------------------------------------------
    */

    withName: 'FASTQDL_METADATA' {
        ext.args   = { "--provider ${params.fastqdl_provider} --silent" }
        publishDir = [
            path: { "${params.outdir}/download/metadata" },
            mode: params.publish_dir_mode,
            enabled: params.save_download_metadata,
            pattern: '*.{tsv,csv}'
        ]
    }

    withName: 'FASTQDL' {
        // --force lets a retried task overwrite the partial file the failed
        // attempt left behind in the task directory.
        // The provider is resolved per run rather than per pipeline. An archive
        // can list a file it cannot serve, and the other archive usually still
        // has it; naming the run in --fastqdl_sra_runs moves that task alone and
        // leaves every other task's command, and so its cache entry, untouched.
        ext.args   = {
            def sra_runs = (params.fastqdl_sra_runs ?: '').tokenize(',')*.trim().findAll()
            def provider = (meta.run_accession in sra_runs || meta.id in sra_runs)
                ? 'sra'
                : params.fastqdl_provider
            "--provider ${provider} --silent --force --max-attempts 5"
        }
        publishDir = [
            path: { "${params.outdir}/download/fastq" },
            mode: params.publish_dir_mode,
            enabled: params.save_download_metadata,
            pattern: '*-run-info.tsv'
        ]
    }

    withName: 'CAT_FASTQ' {
        publishDir = [
            enabled: false
        ]
    }

    /*
    ------------------------------------------------------------------------
        Host reference
    ------------------------------------------------------------------------
    */

    withName: 'NCBIGENOMEDOWNLOAD' {
        // --section must match the accession namespace: GCA_* is GenBank,
        // GCF_* is RefSeq. A taxid query is narrowed to the reference assembly
        // so that it resolves to exactly one genome.
        ext.args   = {
            [
                '--formats fasta',
                meta.section ? "--section ${meta.section}" : '',
                params.host_taxid && !params.host_accession ? '--refseq-categories reference' : '',
                params.ncbi_args ?: ''
            ].findAll { arg -> arg }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/reference/genome" },
            mode: params.publish_dir_mode,
            enabled: params.save_reference
        ]
    }

    withName: 'GUNZIP' {
        publishDir = [
            path: { "${params.outdir}/reference/genome" },
            mode: params.publish_dir_mode,
            enabled: params.save_reference
        ]
    }

    withName: 'HISAT2_BUILD' {
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            enabled: params.save_reference
        ]
    }

    withName: 'UNTAR' {
        publishDir = [
            enabled: false
        ]
    }

    /*
    ------------------------------------------------------------------------
        Read QC and trimming
    ------------------------------------------------------------------------
    */

    withName: 'FASTQC_RAW' {
        ext.args   = '--quiet'
        ext.prefix = { "${meta.id}_raw" }
        publishDir = [
            path: { "${params.outdir}/fastqc/raw" },
            mode: params.publish_dir_mode,
            pattern: '*.html'
        ]
    }

    withName: 'FASTQC_TRIM' {
        ext.args   = '--quiet'
        ext.prefix = { "${meta.id}_trimmed" }
        publishDir = [
            path: { "${params.outdir}/fastqc/trimmed" },
            mode: params.publish_dir_mode,
            pattern: '*.html'
        ]
    }

    withName: 'FASTP' {
        // Adapters are auto-detected for both single- and paired-end input;
        // --detect_adapter_for_pe is what enables it for the latter.
        //
        // The low-complexity filter is appended rather than folded into
        // --fastp_args, so turning it on does not mean restating the adapter
        // settings. It is off by default because it removes reads, and a read
        // removed at trimming is invisible to every count downstream.
        //
        // --compression_level rides in as fastp's -z, clamped to 1: fastp
        // rejects 0, and its own default is 4 rather than gzip's 6.
        ext.args   = {
            def base = params.fastp_args ?: '--detect_adapter_for_pe'
            if (params.compression_level != null) {
                base = "${base} -z ${Math.max(1, params.compression_level as int)}"
            }
            params.trim_low_complexity
                ? "${base} --low_complexity_filter --complexity_threshold ${params.low_complexity_threshold}"
                : base
        }
        publishDir = [
            [
                path: { "${params.outdir}/fastp" },
                mode: params.publish_dir_mode,
                pattern: '*.{json,html,log}'
            ],
            [
                path: { "${params.outdir}/fastp/trimmed" },
                mode: params.publish_dir_mode,
                enabled: params.save_trimmed,
                pattern: '*.fastp.fastq.gz'
            ],
            [
                path: { "${params.outdir}/fastp/failed" },
                mode: params.publish_dir_mode,
                enabled: params.save_trimmed_fail,
                pattern: '*.fail.fastq.gz'
            ]
        ]
    }

    /*
    ------------------------------------------------------------------------
        Host depletion
    ------------------------------------------------------------------------
    */

    /*
    ------------------------------------------------------------------------
        rRNA depletion
    ------------------------------------------------------------------------
    */

    withName: '.*:RRNA_REMOVAL_SORTMERNA:SORTMERNA_INDEX' {
        // `--index 1` is what the module reads to switch into index-only mode.
        ext.args   = '--index 1'
        publishDir = [
            path: { "${params.outdir}/reference/sortmerna" },
            mode: params.publish_dir_mode,
            enabled: params.save_reference
        ]
    }

    withName: '.*:RRNA_REMOVAL_SORTMERNA:SORTMERNA_READS' {
        // `--index 0` reuses the index built above instead of rebuilding it per
        // sample. `--paired_in` and `--out2` are added by the module itself for
        // paired input, so they are deliberately absent here.
        ext.args   = {
            [
                '--index 0',
                params.sortmerna_args ?: ''
            ].findAll { arg -> arg }.join(' ')
        }
        ext.prefix = { "${meta.id}" }
        publishDir = [
            [
                path: { "${params.outdir}/sortmerna" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ],
            [
                path: { "${params.outdir}/sortmerna/reads" },
                mode: params.publish_dir_mode,
                enabled: params.save_trimmed,
                pattern: '*non_rRNA.fastq.gz'
            ]
        ]
    }

    // --compression_level, wherever a local module drives gzip/pigz itself and
    // so cannot take the level through the tool's own ext.args.
    withName: 'KRAKEN2_DAEMON|KRAKEN2_DAEMON_SHUFFLED|STARSOLO_UNMAPPED|KRAKENTOOLS_EXTRACTREADS' {
        ext.compression = { params.compression_level }
    }

    // --compression_level, for the BAMs the split aligner writes itself.
    // HISAT2_ALIGN_SPLIT pipes through samtools rather than through the nf-core
    // module, so the level cannot ride in on the module's own ext.args.
    withName: 'HISAT2_ALIGN_SPLIT|HISAT2_ALIGN_SPLIT_CHUNK' {
        ext.compression = { params.compression_level }
    }

    withName: 'HISAT2_ALIGN|HISAT2_ALIGN_SPLIT' {
        // --very-sensitive expands to `--bowtie2-dp 2 -k 50 --score-min L,0,-1`.
        // The `-k 50` costs alignment TIME, not disk: the module pipes hisat2
        // through `samtools view -F 256`, so the 49 secondary alignments per
        // read are dropped before anything is written and the BAM already holds
        // one primary alignment per aligned read (which is what makes it usable
        // for counting - see SUBREAD_FEATURECOUNTS).
        // --hisat2_max_alignments appends `-k N` AFTER the preset, and HISAT2
        // ignores it: a run with `--very-sensitive -k 1` produced the same
        // alignment rates and the same NH-tag distribution as `-k 50`, so the
        // preset is applied last and wins. validateInputParameters() warns
        // about the combination; to actually cap the alignments, replace the
        // preset with its expansion in --hisat2_args.
        // --temp-directory is not optional here. The hisat2 wrapper hardcodes
        // /tmp and names its named pipes "<pid>.inpipe1/2"; inside containers
        // PIDs restart low and repeat, so two paired-end samples running at the
        // same time on one node both try to mkfifo /tmp/45.inpipe1 and one of
        // them dies with "mkfifo(...) failed". Pointing it at the task work
        // directory makes the name unique per task.
        ext.args   = {
            [
                '--temp-directory .',
                params.hisat2_args ?: '',
                params.hisat2_max_alignments ? "-k ${params.hisat2_max_alignments}" : ''
            ].findAll { arg -> arg }.join(' ')
        }
        ext.prefix = { "${meta.id}.host" }
        publishDir = [
            [
                path: { "${params.outdir}/hisat2/log" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ],
            [
                path: { "${params.outdir}/unaligned" },
                mode: params.publish_dir_mode,
                enabled: params.save_unaligned,
                pattern: '*.unmapped*.fastq.gz'
            ]
        ]
    }

    // With more than one host reference every pass but the last is an
    // intermediate: its leftovers feed the next pass, so only the FINAL pass
    // publishes non-host FASTQs. Naming them apart is not cosmetic - without a
    // distinct prefix each pass would write `<id>.host.unmapped_1.fastq.gz` and
    // `<id>.host.sorted.bam` into the same published directories and overwrite
    // the final pass's. It also keeps the read-accounting table able to report
    // what each reference removed: bin/read_accounting.py keys on
    // `<id>.<label>.` and orders `host1` < `host2` < ... < `host` (final).
    // With --univec the FINAL host pass is no longer the last one, so it stops
    // publishing non-host FASTQs and the UniVec pass publishes them instead.
    // Exactly one process must, or `unaligned/` holds two sets of reads and
    // nothing says which is which.
    withName: '.*:HOST_DEPLETION_FINAL:(HISAT2_ALIGN|HISAT2_ALIGN_SPLIT)' {
        ext.prefix = { "${meta.id}.host" }
        publishDir = [
            [
                path: { "${params.outdir}/hisat2/log" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ],
            [
                path: { "${params.outdir}/unaligned" },
                mode: params.publish_dir_mode,
                enabled: params.save_unaligned && !params.univec,
                pattern: '*.unmapped*.fastq.gz'
            ]
        ]
    }

    // The UniVec pass replaces ext.args wholesale rather than adding to it.
    // Inheriting --hisat2_args would apply --very-sensitive to a vector
    // database, and `--score-min L,0,-1` against a 3 kb plasmid backbone
    // removes real reads. --temp-directory stays: see the note above on why it
    // is not optional.
    withName: '.*:HOST_DEPLETION_UNIVEC:(HISAT2_ALIGN|HISAT2_ALIGN_SPLIT)' {
        ext.args   = {
            ['--temp-directory .', params.univec_hisat2_args ?: ''].findAll { arg -> arg }.join(' ')
        }
        ext.prefix = { "${meta.id}.univec" }
        publishDir = [
            [
                path: { "${params.outdir}/hisat2/log" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ],
            [
                path: { "${params.outdir}/unaligned" },
                mode: params.publish_dir_mode,
                enabled: params.save_unaligned,
                pattern: '*.unmapped*.fastq.gz'
            ]
        ]
    }

    withName: '.*:HOST_DEPLETION_UNIVEC:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.univec.sorted" }
    }

    withName: '.*:HOST_DEPLETION_FIRST:(HISAT2_ALIGN|HISAT2_ALIGN_SPLIT)' {
        ext.prefix = { "${meta.id}.host1" }
        publishDir = [
            [
                path: { "${params.outdir}/hisat2/log" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ]
        ]
    }

    withName: '.*:HOST_DEPLETION_FIRST:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.host1.sorted" }
    }

    withName: '.*:HOST_DEPLETION_EXTRA1:(HISAT2_ALIGN|HISAT2_ALIGN_SPLIT)' {
        ext.prefix = { "${meta.id}.host2" }
        publishDir = [
            [
                path: { "${params.outdir}/hisat2/log" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ]
        ]
    }

    withName: '.*:HOST_DEPLETION_EXTRA1:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.host2.sorted" }
    }

    withName: '.*:HOST_DEPLETION_EXTRA2:(HISAT2_ALIGN|HISAT2_ALIGN_SPLIT)' {
        ext.prefix = { "${meta.id}.host3" }
        publishDir = [
            [
                path: { "${params.outdir}/hisat2/log" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ]
        ]
    }

    withName: '.*:HOST_DEPLETION_EXTRA2:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.host3.sorted" }
    }

    // --hisat2_chunk_size. The chunk tasks are intermediates: they publish
    // nothing, and HISAT2_MERGECHUNKS below produces the same three files under
    // the same names an unchunked run would have, so the pass-specific rules
    // above still decide what reaches the output directory.
    //
    // Two details are load-bearing. `-s/-u` are the chunk itself: HISAT2 counts
    // them in reads-or-pairs, so each task aligns its own window of the same
    // FASTQ. And --rg-id is pinned to the SAMPLE rather than left to the module,
    // which derives it from the (per-chunk) prefix: `samtools cat` takes the
    // header of the first file for the whole output, so a per-chunk read group
    // would leave every later chunk's records pointing at an @RG that is not in
    // the merged header.
    withName: '.*:(HISAT2_ALIGN_CHUNK|HISAT2_ALIGN_SPLIT_CHUNK)' {
        ext.args   = {
            [
                '--temp-directory .',
                params.hisat2_args ?: '',
                params.hisat2_max_alignments ? "-k ${params.hisat2_max_alignments}" : '',
                "-s ${meta.chunk_skip}",
                "-u ${meta.chunk_upto}",
                "--rg-id ${meta.id}.host --rg SM:${meta.id}.host"
            ].findAll { arg -> arg }.join(' ')
        }
        ext.prefix = { "${meta.id}.${meta.chunk}" }
        publishDir = []
    }

    withName: '.*:HOST_DEPLETION_FINAL:HISAT2_MERGECHUNKS' {
        ext.prefix = { "${meta.id}.host" }
        publishDir = [
            [
                path: { "${params.outdir}/hisat2/log" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ],
            [
                path: { "${params.outdir}/unaligned" },
                mode: params.publish_dir_mode,
                enabled: params.save_unaligned && !params.univec,
                pattern: '*.unmapped*.fastq.gz'
            ]
        ]
    }

    withName: '.*:HOST_DEPLETION_UNIVEC:HISAT2_MERGECHUNKS' {
        ext.prefix = { "${meta.id}.univec" }
        publishDir = [
            [
                path: { "${params.outdir}/hisat2/log" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ],
            [
                path: { "${params.outdir}/unaligned" },
                mode: params.publish_dir_mode,
                enabled: params.save_unaligned,
                pattern: '*.unmapped*.fastq.gz'
            ]
        ]
    }

    withName: '.*:HOST_DEPLETION_FIRST:HISAT2_MERGECHUNKS' {
        ext.prefix = { "${meta.id}.host1" }
        publishDir = [
            [
                path: { "${params.outdir}/hisat2/log" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ]
        ]
    }

    withName: '.*:HOST_DEPLETION_EXTRA1:HISAT2_MERGECHUNKS' {
        ext.prefix = { "${meta.id}.host2" }
        publishDir = [
            [
                path: { "${params.outdir}/hisat2/log" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ]
        ]
    }

    withName: '.*:HOST_DEPLETION_EXTRA2:HISAT2_MERGECHUNKS' {
        ext.prefix = { "${meta.id}.host3" }
        publishDir = [
            [
                path: { "${params.outdir}/hisat2/log" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ]
        ]
    }

    withName: 'HISAT2_CHUNKPLAN' {
        publishDir = []
    }

    /*
    ------------------------------------------------------------------------
        Targeted taxon (--target_taxid)
    ------------------------------------------------------------------------
        The branch reuses the host alignment and host expression subworkflows
        whole, so every process in it ALSO matches the generic host selectors
        below and would publish `<id>.host*` into the host directories, on top
        of the real host pass's files. These pass-qualified selectors are what
        keep the two apart; a missing one is a silent overwrite, not an error.
    */
    withName: '.*:KRAKENTOOLS_EXTRACTREADS' {
        ext.args   = {
            [
                params.target_include_children ? '--include-children' : '',
                params.target_include_parents ? '--include-parents' : '',
                "--max ${params.target_max_reads}"
            ].findAll { arg -> arg }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/targeted/reads" },
            mode: params.publish_dir_mode,
            pattern: '*.fastq.gz'
        ]
    }

    withName: '.*:TARGET_ALIGNMENT:(HISAT2_ALIGN|HISAT2_ALIGN_SPLIT|HISAT2_MERGECHUNKS)' {
        ext.prefix = { "${meta.id}.target" }
        publishDir = [
            [
                path: { "${params.outdir}/targeted/log" },
                mode: params.publish_dir_mode,
                pattern: '*.log'
            ]
        ]
    }

    // Stays BAM whatever --alignment_output_format says: this holds one taxon's
    // reads, so the saving would be negligible, and it is encoded against the
    // target genome rather than against --host. Setting ext.args here also
    // displaces the '--output-fmt cram' the generic SAMTOOLS_SORT rule carries.
    withName: '.*:TARGET_ALIGNMENT:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_SORT' {
        ext.args   = { params.compression_level != null ? "-l ${params.compression_level}" : '' }
        ext.prefix = { "${meta.id}.target.sorted" }
        publishDir = [
            path: { "${params.outdir}/targeted" },
            mode: params.publish_dir_mode,
            pattern: '*.bam'
        ]
    }

    withName: '.*:TARGET_ALIGNMENT:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/targeted" },
            mode: params.publish_dir_mode,
            pattern: '*.{bai,csi}'
        ]
    }

    withName: '.*:TARGET_ALIGNMENT:.*:(SAMTOOLS_STATS|SAMTOOLS_FLAGSTAT|SAMTOOLS_IDXSTATS)' {
        publishDir = [
            path: { "${params.outdir}/targeted/samtools_stats" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:TARGET_ALIGNMENT:SUBREAD_FEATURECOUNTS' {
        ext.prefix = { "${meta.id}.target" }
        publishDir = [
            path: { "${params.outdir}/targeted/counts" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:TARGET_EXPRESSION:(GENE_DE_DESEQ2|GENE_DE_EDGER)' {
        ext.prefix = { 'reanatax.target_de' }
        publishDir = [
            path: { "${params.outdir}/targeted" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: '.*:KALLISTO_QUANT' {
        // -l/-s are required for single-end input and rejected for paired: with
        // two ends kallisto measures the fragment-length distribution itself.
        ext.args   = {
            [
                meta.single_end ? "--single -l ${params.kallisto_fragment_length} -s ${params.kallisto_fragment_sd}" : '',
                params.kallisto_args ?: ''
            ].findAll { arg -> arg }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/kallisto" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:TARGET_KALLISTO:.*' {
        publishDir = [
            path: { "${params.outdir}/targeted/kallisto" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:TARGET_KALLISTO:KALLISTO_MERGE' {
        ext.prefix = { 'reanatax.target' }
        publishDir = [
            path: { "${params.outdir}/targeted" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'KALLISTO_MERGE' {
        ext.prefix = { 'reanatax.host' }
        publishDir = [
            path: { "${params.outdir}/host_expression" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:TARGET_COUNTS_MERGE' {
        ext.prefix = { 'reanatax.target' }
        publishDir = [
            path: { "${params.outdir}/targeted" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'HOSTCOUNTS_MERGE' {
        ext.prefix = { 'reanatax' }
        publishDir = [
            path: { "${params.outdir}/host_expression" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GENE_DE_DESEQ2|GENE_DE_EDGER' {
        // The gene-level contrast is the same one the microbial side uses, so it
        // reads the same --da_* parameters rather than duplicating them.
        ext.args   = {
            [
                "--grouping ${params.da_grouping}",
                "--sample-group ${params.da_sample_group}",
                "--ref-group ${params.da_ref_group}",
                params.da_covariates ? "--covariates ${params.da_covariates}" : '',
                params.da_samples_to_drop ? "--samples-to-drop ${params.da_samples_to_drop}" : '',
                "--min-count ${params.host_de_min_count}",
                "--min-samples ${params.host_de_min_samples}",
                "--p-threshold ${params.da_p_threshold}",
                "--lfc-threshold ${params.da_lfc_threshold}"
            ].findAll { arg -> arg }.join(' ')
        }
        ext.prefix = { 'reanatax.host_de' }
        publishDir = [
            path: { "${params.outdir}/host_expression" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'HOSTMICROBE_CORRELATION' {
        ext.args   = {
            [
                "--p-threshold ${params.da_p_threshold}",
                "--top-genes ${params.host_microbe_top_genes}",
                "--top-taxa ${params.host_microbe_top_taxa}"
            ].join(' ')
        }
        ext.prefix = { 'reanatax' }
        publishDir = [
            path: { "${params.outdir}/host_expression" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'SUBREAD_FEATURECOUNTS' {
        // -p/--countReadPairs only make sense for paired-end libraries, and
        // featureCounts errors out if given them for single-end input.
        ext.args   = {
            [
                "-t ${params.featurecounts_feature_type}",
                "-g ${params.featurecounts_attribute}",
                meta.single_end ? '' : '-p --countReadPairs',
                params.featurecounts_args ?: ''
            ].findAll { arg -> arg }.join(' ')
        }
        ext.prefix = { "${meta.id}.host" }
        publishDir = [
            path: { "${params.outdir}/host_counts" },
            mode: params.publish_dir_mode
        ]
    }

    // --alignment_output_format and --compression_level, both applied here
    // rather than inside the module so the format stays overridable per pass.
    // `--output-fmt cram` is what the local BAM_SORT_STATS_SAMTOOLS keys off:
    // SAMTOOLS_SORT decides its own extension from this string.
    withName: 'SAMTOOLS_SORT' {
        ext.args   = { [
            params.compression_level != null ? "-l ${params.compression_level}" : '',
            params.alignment_output_format == 'cram' ? '--output-fmt cram' : ''
        ].findAll { entry -> entry }.join(' ') }
        ext.prefix = { "${meta.id}.host.sorted" }
        publishDir = [
            path: { "${params.outdir}/hisat2" },
            mode: params.publish_dir_mode,
            enabled: params.save_host_bam,
            pattern: '*.{bam,cram}'
        ]
    }

    withName: 'SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/hisat2" },
            mode: params.publish_dir_mode,
            enabled: params.save_host_bam,
            pattern: '*.{bai,csi,crai}'
        ]
    }


    withName: 'SAMTOOLS_STATS|SAMTOOLS_FLAGSTAT|SAMTOOLS_IDXSTATS' {
        publishDir = [
            path: { "${params.outdir}/hisat2/samtools_stats" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'QUALIMAP_BAMQC' {
        ext.args   = { params.qualimap_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/qualimap" },
            mode: params.publish_dir_mode
        ]
    }

    /*
    ------------------------------------------------------------------------
        Taxonomic classification
    ------------------------------------------------------------------------
    */

    // The shuffled aliases are named here so they inherit EXACTLY the same
    // Kraken2 arguments as the real pass. A control run at a different
    // confidence or a different minimum-hit-group count measures a different
    // classifier, and the ratio it produces would mean nothing.
    withName: 'KRAKEN2_KRAKEN2|KRAKEN2_DAEMON|KRAKEN2_SHUFFLED|KRAKEN2_DAEMON_SHUFFLED' {
        ext.args   = {
            [
                params.kraken2_confidence ? "--confidence ${params.kraken2_confidence}" : '',
                "--minimum-hit-groups ${params.kraken2_min_hit_groups}",
                params.kraken2_memory_mapping ? '--memory-mapping' : '',
                params.kraken2_report_minimizer_data ? '--report-minimizer-data' : '',
                '--use-names',
                params.kraken2_args ?: ''
            ].findAll { arg -> arg }.join(' ')
        }
        publishDir = [
            [
                path: { "${params.outdir}/kraken2" },
                mode: params.publish_dir_mode,
                pattern: '*{report.txt,k2.log}'
            ],
            [
                path: { "${params.outdir}/kraken2/reads" },
                mode: params.publish_dir_mode,
                enabled: params.kraken2_save_reads,
                pattern: '*{classified,unclassified}*'
            ],
            [
                path: { "${params.outdir}/kraken2/read_assignments" },
                mode: params.publish_dir_mode,
                enabled: params.kraken2_save_readclassifications,
                pattern: '*classifiedreads.txt'
            ]
        ]
    }

    // ...and then publish somewhere else. The report file name is deliberately
    // the sample id, unchanged, because SHUFFLE_COMPARE pairs the two
    // classifications by basename; the separate directory is what keeps them
    // apart on disk, and keeping them out of MultiQC is what stops the control
    // being read as a second set of samples.
    withName: 'KRAKEN2_SHUFFLED|KRAKEN2_DAEMON_SHUFFLED' {
        publishDir = [
            path: { "${params.outdir}/shuffle_control/kraken2" },
            mode: params.publish_dir_mode,
            pattern: '*{report.txt,k2.log}'
        ]
    }

    withName: 'SHUFFLE_READS' {
        publishDir = [
            path: { "${params.outdir}/shuffle_control/reads" },
            mode: params.publish_dir_mode,
            // The shuffled FASTQs are a means, not a result, and they are the
            // same size as the library. Only the accounting is kept.
            pattern: '*.shuffle_stats.tsv'
        ]
    }

    withName: 'SHUFFLE_COMPARE' {
        ext.prefix = { 'reanatax' }
        publishDir = [
            path: { "${params.outdir}/shuffle_control" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,txt}'
        ]
    }

    withName: 'KRAKENTOOLS_COMBINEKREPORTS' {
        // Without --sample-names the columns are labelled with file names.
        // meta.names is built in the subworkflow in the same order as the files.
        ext.args   = { "--sample-names ${meta.names} --display-headers" }
        ext.prefix = 'kraken2_combined_report'
        publishDir = [
            path: { "${params.outdir}/kraken2" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MEGAHIT' {
        ext.args        = { [
            "--min-contig-len ${params.assembly_min_contig_len}",
            params.assembly_args ?: ''
        ].findAll { entry -> entry }.join(' ') }
        ext.compression = { params.compression_level }
        publishDir      = [
            path: { "${params.outdir}/assembly" },
            mode: params.publish_dir_mode,
            pattern: '*.{contigs.fa.gz,megahit.log}'
        ]
    }

    withName: 'SPADES_META' {
        ext.args        = { params.assembly_args ?: '' }
        ext.compression = { params.compression_level }
        publishDir      = [
            path: { "${params.outdir}/assembly" },
            mode: params.publish_dir_mode,
            pattern: '*.{contigs.fa.gz,spades.log}'
        ]
    }

    withName: 'KRAKEN2_CONTIGS|KRAKEN2_DAEMON_CONTIGS' {
        // No --confidence here even when the read pass uses one. Confidence is a
        // fraction of a sequence's k-mers agreeing, and a contig has orders of
        // magnitude more of them than a read; the same threshold means something
        // entirely different applied to 2 kb than to 100 bp.
        ext.args   = { params.kraken2_min_hit_groups ? "--minimum-hit-groups ${params.kraken2_min_hit_groups}" : '' }
        ext.prefix = { "${meta.id}.contigs" }
        publishDir = [
            path: { "${params.outdir}/assembly" },
            mode: params.publish_dir_mode,
            pattern: '*.contigs.kraken2.report.txt'
        ]
    }

    withName: 'CONTIG_EVIDENCE' {
        ext.prefix = 'reanatax'
        publishDir = [
            path: { "${params.outdir}/assembly" },
            mode: params.publish_dir_mode,
            pattern: '*.{contig_evidence.tsv,contig_drop.txt}'
        ]
    }

    withName: 'KRAKENBIOM' {
        // --max D keeps the ranks above order, which kraken-biom's own default
        // (--max O) discards. A great deal of Kraken2 signal never reaches
        // species - on the CSI-Microbes plate every false positive the control
        // filter removed sat at genus - and a BIOM that starts at order would
        // not show it. Counts stay additive: only the minimum rank carries
        // clade reads, every rank above it carries reads that stopped there.
        ext.args   = '--max D --min S'
        publishDir = [
            path: { "${params.outdir}/biom" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BRACKEN_BRACKEN' {
        // -r comes from the meta, not from params: it is resolved per sample
        // from the trimmed read length and snapped to a k-mer distribution the
        // database actually ships (see resolveBrackenReadLength).
        ext.args   = { "-r ${meta.bracken_r} -l ${params.bracken_level} -t ${params.bracken_threshold}" }
        ext.prefix = { "${meta.id}.bracken_${params.bracken_level}" }
        publishDir = [
            path: { "${params.outdir}/bracken" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BRACKEN_COMBINEBRACKENOUTPUTS' {
        // As above: label the columns with sample ids, not with file names.
        ext.args   = { "--names ${meta.names}" }
        ext.prefix = { "bracken_combined_${params.bracken_level}" }
        publishDir = [
            path: { "${params.outdir}/bracken" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'KRAKENTOOLS_KREPORT2KRONA' {
        ext.prefix = { "${meta.id}.krona" }
        publishDir = [
            enabled: false
        ]
    }

    withName: 'KRONA_KTIMPORTTEXT' {
        ext.prefix = { "${meta.id}.krona" }
        publishDir = [
            path: { "${params.outdir}/krona" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FILTER_KRAKEN2|FILTER_BRACKEN' {
        // --drop_host_taxon removes the host rows and renormalises what is
        // left, so a sample carrying host through depletion does not deflate
        // every microbial abundance by the host's share. The dropped rows go
        // to the .removed.tsv, and the unfiltered combined table is published
        // beside it either way.
        ext.args = { params.drop_host_taxon ? "--drop-taxid ${params.host_carryover_taxid}" : '' }
    }

    withName: 'FILTER_KRAKEN2' {
        ext.prefix = 'kraken2_combined_report'
        publishDir = [
            path: { "${params.outdir}/kraken2" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FILTER_BRACKEN' {
        ext.prefix = { "bracken_combined_${params.bracken_level}" }
        publishDir = [
            path: { "${params.outdir}/bracken" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'SPARCC_PREPARE|SPARCC_CORRELATION|SPARCC_NETWORK' {
        ext.prefix = { 'reanatax' }
        publishDir = [
            path: { "${params.outdir}/sparcc" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'GENEDIV_GENE|GENEDIV_PRODUCT' {
        ext.prefix = { 'reanatax' }
        publishDir = [
            path: { "${params.outdir}/gene_diversity" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,txt}'
        ]
    }

    // Named for what was applied to it rather than for the level, so it cannot
    // be mistaken for the table FILTER_BRACKEN wrote: this one has additionally
    // had the taxa with no breadth across their own genome removed, and that is
    // a judgement HUMAnN made, downstream of everything in the bracken/
    // directory.
    withName: 'FILTER_PRISM' {
        ext.prefix = { "bracken_combined_${params.bracken_level}_prism" }
        publishDir = [
            path: { "${params.outdir}/prism" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FILTER_GENEDIV' {
        ext.prefix = { "bracken_combined_${params.bracken_level}_genediv" }
        publishDir = [
            path: { "${params.outdir}/gene_diversity" },
            mode: params.publish_dir_mode
        ]
    }

    /*
    ------------------------------------------------------------------------
        Functional profiling
    ------------------------------------------------------------------------
    */

    withName: 'METAPHLAN_PROFILE' {
        // -t rel_ab_w_read_stats adds estimated_number_of_reads_from_the_clade,
        // which the count-based differential-abundance methods need; the
        // relative-abundance ones ignore it. Default on so both stay open.
        ext.args = { params.metaphlan_args ?: '' }
        ext.prefix = { "${meta.id}" }
        publishDir = [
            [
                path: { "${params.outdir}/metaphlan" },
                mode: params.publish_dir_mode,
                pattern: '*_metaphlan.txt'
            ],
            [
                path: { "${params.outdir}/metaphlan/log" },
                mode: params.publish_dir_mode,
                pattern: '*.metaphlan.log'
            ]
        ]
    }

    withName: 'METAPHLAN_MERGE' {
        ext.prefix = 'metaphlan_combined'
        publishDir = [
            path: { "${params.outdir}/metaphlan" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'KRAKENTOOLS_KREPORT2MPA' {
        // --percentages because HUMAnN's --prescreen-threshold (0.01 by
        // default) is read as a percentage: handing it raw read counts would
        // let every taxon through. --display-header keeps the name of the
        // report each profile came from, which is the only provenance the
        // profile carries. The mpa version line HUMAnN insists on is added by
        // the module itself, not here - it is a correctness requirement, not a
        // tunable.
        ext.args   = '--percentages --display-header'
        publishDir = [
            path: { "${params.outdir}/humann/taxonomic_profile" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'HUMANN3_HUMANN' {
        ext.args   = { params.humann_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/humann" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'HUMANN3_REGROUP' {
        publishDir = [
            path: { "${params.outdir}/humann/regrouped" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'HUMANN3_RENORM' {
        // RPK is not comparable between libraries of different depth, so
        // anything cross-sample needs CPM or relative abundance.
        ext.args   = { "--units ${params.humann_renorm}" }
        publishDir = [
            path: { "${params.outdir}/humann/normalised" },
            mode: params.publish_dir_mode
        ]
    }

    /*
    ------------------------------------------------------------------------
        Read accounting and diagnostics
    ------------------------------------------------------------------------
    */

    withName: 'DIFFERENTIAL_ABUNDANCE_ALDEX2|DIFFERENTIAL_ABUNDANCE_ANCOMBC' {
        ext.prefix = { "${meta.id}" }
        ext.args   = {
            [
                "--grouping ${params.da_grouping}",
                "--sample-group ${params.da_sample_group}",
                "--ref-group ${params.da_ref_group}",
                params.da_covariates ? "--covariates ${params.da_covariates}" : '',
                "--prevalence-min ${params.da_prevalence_min}",
                "--relabund-min ${params.da_relabund_min}",
                "--lib-cut ${params.da_lib_cut}",
                "--p-threshold ${params.da_p_threshold}",
                "--lfc-threshold ${params.da_lfc_threshold}",
                params.da_samples_to_drop ? "--samples-to-drop ${params.da_samples_to_drop}" : '',
            ].findAll { arg -> arg }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/differential_abundance" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,png}'
        ]
    }

    withName: 'KRAKENUNIQ_PRELOADEDKRAKENUNIQ' {
        // ext.args goes to the one-off `--preload`; ext.args2 to each
        // classification. The module keys whole-database preloading off the
        // absence of `--preload-size` in ext.args.
        ext.args   = { params.krakenuniq_args ?: '' }
        ext.args2  = { params.krakenuniq_classify_args ?: '' }
        publishDir = [
            [
                path: { "${params.outdir}/krakenuniq" },
                mode: params.publish_dir_mode,
                pattern: '*report.txt'
            ],
            [
                path: { "${params.outdir}/krakenuniq/reads" },
                mode: params.publish_dir_mode,
                enabled: params.krakenuniq_save_reads,
                pattern: '*{classified,unclassified}*.gz'
            ],
            [
                path: { "${params.outdir}/krakenuniq/read_assignments" },
                mode: params.publish_dir_mode,
                enabled: params.krakenuniq_save_readclassifications,
                pattern: '*classified.txt'
            ]
        ]
    }

    withName: '.*:TAXONOMY_KRAKENUNIQ:(COMBINE_KRAKENUNIQ|FILTER_KRAKENUNIQ)' {
        publishDir = [
            path: { "${params.outdir}/krakenuniq" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:TAXONOMY_KRAKENUNIQ:KRONA_KRAKENUNIQ' {
        publishDir = [
            path: { "${params.outdir}/krakenuniq/krona" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'ABUNDANCE_MINIMIZER|MINIMIZER_KRAKENUNIQ' {
        // The correlation test is a flag rather than a threshold, so it rides
        // in on ext.args while the four thresholds stay explicit arguments.
        ext.args   = { params.minimizer_correlation
            ? "--correlation-filter --correlation-p ${params.minimizer_correlation_p}"
            : '' }
        publishDir = [
            path: { "${params.outdir}/minimizer_filter" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,txt}'
        ]
    }

    withName: 'HOSTKMER_SCAN' {
        // Per-sample intermediate: the cohort table is what anyone reads, and
        // publishing one of these per library only clutters the results tree.
        publishDir = [
            enabled: false
        ]
    }

    withName: 'STARSOLO' {
        // Cell Ranger-equivalent defaults for the solo half; the geometry comes
        // from --sc_chemistry. --soloBarcodeReadLength 0 stops STAR rejecting a
        // barcode read whose length does not match CB+UMI exactly, which is
        // common in public data where the read was trimmed.
        ext.args   = {
            def chem = [
                '10xv2': [16, 17, 10],
                '10xv3': [16, 17, 12],
                '10xv4': [16, 17, 12],
            ][params.sc_chemistry] ?: [params.sc_cb_len, params.sc_umi_start, params.sc_umi_len]
            [
                "--soloType ${params.sc_solo_type}",
                "--soloCBlen ${params.sc_cb_len ?: chem[0]}",
                "--soloUMIstart ${params.sc_umi_start ?: chem[1]}",
                "--soloUMIlen ${params.sc_umi_len ?: chem[2]}",
                "--soloFeatures ${params.sc_solo_features}",
                "--soloCellFilter ${params.sc_cell_filter}",
                '--soloUMIdedup 1MM_CR',
                '--soloUMIfiltering MultiGeneUMI_CR',
                '--soloCBmatchWLtype 1MM_multi_Nbase_pseudocounts',
                '--soloBarcodeReadLength 0',
                params.sc_star_args ?: '',
            ].join(' ')
        }
        publishDir = [
            [
                path: { "${params.outdir}/starsolo" },
                mode: params.publish_dir_mode,
                pattern: '*Solo.out'
            ],
            [
                path: { "${params.outdir}/starsolo/log" },
                mode: params.publish_dir_mode,
                pattern: '*Log.final.out'
            ]
        ]
    }

    withName: 'STARSOLO_UNMAPPED' {
        publishDir = [
            path: { "${params.outdir}/starsolo" },
            mode: params.publish_dir_mode,
            pattern: '*.barcode_stats.tsv'
        ]
    }

    withName: 'SCTAXA_FILTER' {
        // Distinct from SCTAXA_COUNTS' per-sample matrices and SCTAXA_PLATE's
        // cohort one, both of which are also called *.cell_taxa.tsv.
        //
        // Derived from meta.id, NOT a constant. On the plate route the matrix is
        // one cohort table (SCTAXA_PLATE, id 'reanatax') so the process runs once
        // and the name is unchanged. On the DROPLET route the matrix is
        // per-sample (SCTAXA_COUNTS), so a constant made every task write
        // `reanatax.filtered.cell_taxa.tsv` into the same publish directory and
        // the last one to finish overwrote the rest. Measured on the
        // CSI-Microbes droplet cohort: three libraries filtered, one file
        // published, the uninfected and heat-killed ones gone without an error.
        ext.prefix = { "${meta.id}.filtered" }
        publishDir = [
            path: { "${params.outdir}/cell_taxa" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'SCTAXA_ENRICHMENT' {
        publishDir = [
            path: { "${params.outdir}/cell_taxa" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'SCTAXA_DENOISE' {
        publishDir = [
            path: { "${params.outdir}/cell_taxa" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,txt}'
        ]
    }

    withName: 'SCTAXA_COUNTS' {
        publishDir = [
            path: { "${params.outdir}/cell_taxa" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    // The evidence and drop list are published; the rewritten table is not.
    // It is an intermediate - the abundance filter reads it and publishes the
    // result - and two tables in one directory differing only in which cells
    // are zeroed would be a trap. The evidence table says which those were.
    withName: 'CONTROL_KRAKEN2' {
        ext.prefix = 'kraken2_combined_report'
        publishDir = [
            path: { "${params.outdir}/control_filter" },
            mode: params.publish_dir_mode,
            pattern: '*.{control_evidence.tsv,control_drop.txt}'
        ]
    }

    withName: 'CONTROL_BRACKEN' {
        ext.prefix = { "bracken_combined_${params.bracken_level}" }
        publishDir = [
            path: { "${params.outdir}/control_filter" },
            mode: params.publish_dir_mode,
            pattern: '*.{control_evidence.tsv,control_drop.txt}'
        ]
    }

    withName: 'CLEANUP_INTERMEDIATES' {
        publishDir = [
            path: { "${params.outdir}/cleanup" },
            mode: params.publish_dir_mode,
            pattern: '*.cleanup.log'
        ]
    }

    withName: 'DECONTAM_FILTER' {
        ext.prefix = { 'reanatax' }
        publishDir = [
            path: { "${params.outdir}/decontam" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,txt}'
        ]
    }

    withName: 'DIVERSITY' {
        ext.prefix = { 'reanatax' }
        publishDir = [
            path: { "${params.outdir}/diversity" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,png}'
        ]
    }

    withName: 'HOSTKMER_MERGE' {
        publishDir = [
            path: { "${params.outdir}/host_kmer_filter" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,txt}'
        ]
    }

    withName: 'PRISM_RUN' {
        ext.args   = { params.prism_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/prism/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: 'prism_out/**'
        ]
    }

    withName: 'PRISM_COMBINE' {
        ext.prefix = { 'reanatax' }
        publishDir = [
            path: { "${params.outdir}/prism" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,txt}'
        ]
    }

    withName: 'GATK4_PATHSEQ' {
        ext.args   = { params.pathseq_args ?: '' }
        publishDir = [
            [
                path: { "${params.outdir}/pathseq" },
                mode: params.publish_dir_mode,
                pattern: '*.{scores.txt,metrics.txt}'
            ],
            [
                path: { "${params.outdir}/pathseq/bam" },
                mode: params.publish_dir_mode,
                enabled: params.pathseq_save_bam,
                pattern: '*.pathseq.bam'
            ]
        ]
    }

    withName: 'PATHSEQ_COMBINE' {
        publishDir = [
            path: { "${params.outdir}/pathseq" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'SCTAXA_AMBIENT' {
        publishDir = [
            path: { "${params.outdir}/singlecell/ambient" },
            mode: params.publish_dir_mode,
            pattern: '*.{tsv,txt}'
        ]
    }

    withName: 'SCTAXA_HOSTDE' {
        publishDir = [
            path: { "${params.outdir}/singlecell/host_de" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'SCTAXA_PLATE' {
        publishDir = [
            path: { "${params.outdir}/singlecell" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'EXPLOREMETATAX_BUNDLE' {
        publishDir = [
            path: { "${params.outdir}/exploremetatax" },
            mode: params.publish_dir_mode,
            pattern: '*.tar.gz'
        ]
    }

    withName: 'READ_ACCOUNTING' {
        publishDir = [
            path: { "${params.outdir}/read_accounting" },
            mode: params.publish_dir_mode,
            pattern: '*.read_accounting.tsv'
        ]
    }

    // The per-sample table is published because it is the only place the raw
    // numbers survive: POLYA_MERGE keeps the observed/expected RATIO for
    // MultiQC and drops both percentages, and it is the percentages that
    // Monteleone et al. report (~2.5% observed against a ~5.5-6% background at
    // 8 nt). A ratio alone cannot be compared against that.
    withName: 'POLYA_CARRYOVER' {
        ext.args   = { params.polya_args ?: '' }
        publishDir = [
            path: { "${params.outdir}/polya" },
            mode: params.publish_dir_mode,
            pattern: '*.polya.tsv'
        ]
    }

    withName: 'POLYA_MERGE' {
        publishDir = [
            path: { "${params.outdir}/read_accounting" },
            mode: params.publish_dir_mode
        ]
    }

    /*
    ------------------------------------------------------------------------
        Reporting
    ------------------------------------------------------------------------
    */

    withName: 'MULTIQC' {
        // --multiqc_ai_builtin turns on MultiQC's own AI summary (one summary
        // of the whole report). The matching OPENAI_API_KEY is exported from
        // the `env` scope in nextflow.config - see the note there for why it
        // cannot be done here.
        ext.args   = {
            [
                params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '',
                params.multiqc_ai_builtin ? (params.multiqc_ai_summary == 'short' ? '--ai-summary' : '--ai-summary-full') : '',
                params.multiqc_ai_builtin ? "--ai-provider custom --ai-model ${params.llm_model}" : '',
                params.multiqc_ai_builtin ? "--ai-custom-endpoint ${params.llm_endpoint} --ai-custom-context-window ${params.llm_context_window}" : ''
            ].findAll { arg -> arg }.join(' ')
        }
        // With an endpoint configured the raw report is NOT published, and
        // `multiqc_ai/` holds the only copy. Two things put the endpoint in
        // there: the methods-description section embeds `workflow.commandLine`
        // verbatim (so `--llm_endpoint <url> --llm_api_key <key>` is in the
        // HTML), and --multiqc_ai_builtin bakes the endpoint in as well.
        // MULTIQC_AI scrubs both, so it publishes and this does not.
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            enabled: !params.llm_endpoint
        ]
    }

    /*
    ------------------------------------------------------------------------
        AI annotation (all opt-in; nothing runs without --llm_endpoint)
    ------------------------------------------------------------------------
    */

    withName: 'LLM_INSIGHT' {
        ext.args   = { "--task taxonomy --title '${workflow.manifest.name} taxonomic profile' --timeout ${params.llm_timeout} --context-window ${params.llm_context_window}" }
        ext.prefix = 'taxonomy'
        publishDir = [
            path: { "${params.outdir}/ai" },
            mode: params.publish_dir_mode,
            pattern: '*.ai_insight.md'
        ]
    }

    withName: 'MULTIQC_AI' {
        ext.args   = { "--llm-timeout ${params.llm_timeout} --llm-context-window ${params.llm_context_window}" }
        publishDir = [
            path: { "${params.outdir}/multiqc_ai" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'QUALIMAP_AI' {
        // Per-plot boxes mean one extra LLM call per plot per sample, which for
        // a real cohort is hours of serialised requests. Hence opt-in.
        ext.args   = {
            [
                params.ai_qualimap_sections ? '--sections' : '',
                "--llm-timeout ${params.llm_timeout}",
                "--llm-context-window ${params.llm_context_window}"
            ].findAll { arg -> arg }.join(' ')
        }
        publishDir = [
            path: { "${params.outdir}/qualimap_ai" },
            mode: params.publish_dir_mode
        ]
    }

}
