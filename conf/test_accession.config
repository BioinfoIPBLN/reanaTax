/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for testing the accession download route
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Same tiny reference and database as `-profile test`, but the reads are
    fetched from ENA instead of read from a samplesheet. Kept separate from
    `test` because it depends on the public archives being reachable.

    Use as follows:
        nextflow run BioinfoIPBLN/reanatax -profile test_accession,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '15.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Accession download test profile'
    config_profile_description = 'Downloads two very small public metagenomes with fastq-dl'

    // SRX9626017: 91 paired-end reads, human gut metagenome (PRJNA682076)
    // ERX1234253: 283 single-end reads, metagenome (PRJEB11419)
    // Together ~50 kB, so this exercises the download path without being slow.
    input_accessions           = 'SRX9626017,ERX1234253'
    group_runs_by              = 'experiment'
    max_download_forks         = 2

    fasta                      = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta'
    kraken2_db                 = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/sarscov2/genome/db/kraken2_bracken.tar.gz'
    bracken_read_length        = 100

    // These libraries are far too small to survive Bracken's re-estimation.
    skip_bracken               = true
}
