/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    BioinfoIPBLN/reanatax Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    // Every task gets its own temp directory, created here because no tool
    // creates TMPDIR for itself. Paired with `env.TMPDIR = './tmp'` in
    // nextflow.config: without it, tools inherit whatever TMPDIR the submitting
    // shell happened to have - Nextflow forwards it into the container - and
    // fall back to a shared /tmp when it is unset. That makes temp behaviour a
    // property of the login shell rather than of the pipeline, and puts spill
    // files from concurrent runs in one directory on a shared node.
    //
    // A subdirectory rather than the task directory itself: samtools sort names
    // its spill files `<prefix>.tmp.NNNN.bam`, which an output glob of `*.bam`
    // would collect.
    beforeScript = 'mkdir -p tmp'

    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    // nf-core's stock list of retryable exit statuses, plus the case it misses.
    // When a task exceeds its `time`, the local executor kills it from inside
    // Nextflow and no .exitcode file is ever written, so task.exitStatus comes
    // back as the "missing" sentinel rather than a signal in 130..145. Without
    // the unknown-status branch the escalating `time = N.h * task.attempt`
    // below is dead on every local run: the first attempt is killed at the
    // limit and the second attempt, which would have had twice the budget,
    // never happens. Bounded by maxRetries, so an unknown failure that is not a
    // timeout costs exactly one extra attempt.
    errorStrategy = {
        def status = task.exitStatus
        def unknown = status == null || status == Integer.MAX_VALUE
        unknown || status in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish'
    }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and reuse the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_low_memory {
        memory = { 1.GB * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }

    /*
    ------------------------------------------------------------------------
        Pipeline-specific overrides
    ------------------------------------------------------------------------
    */

    // Downloads are network-bound, not CPU-bound. One core each, capped so the
    // pipeline stays a well-behaved ENA/SRA client, and retried generously
    // because transient HTTP/FTP failures are the norm at scale.
    withName: 'FASTQDL|FASTQDL_METADATA' {
        cpus          = { 2 }
        memory        = { 2.GB * task.attempt }
        time          = { 8.h  * task.attempt }
        maxForks      = params.max_download_forks as int
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries    = 3
    }

    withName: 'NCBIGENOMEDOWNLOAD' {
        cpus          = { 2 }
        memory        = { 4.GB * task.attempt }
        time          = { 4.h  * task.attempt }
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries    = 3
    }

    // hisat2-build is the single most memory-hungry step when a splice-aware
    // index is requested (a vertebrate genome with --ss/--exon needs ~160-200 GB;
    // without them ~8 GB). params.hisat2_build_memory is the threshold the
    // module uses to decide which of the two it can afford.
    withName: 'HISAT2_BUILD' {
        cpus   = { 12 }
        memory = { params.gtf ? params.hisat2_build_memory : 24.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    // Both alignment modules, not just the nf-core one: with
    // --require_both_mates_unmapped (the default) the pipeline runs
    // HISAT2_ALIGN_SPLIT, and a bare 'HISAT2_ALIGN' selector does not match it,
    // so the tuning below silently applied to neither the default path nor any
    // run that used it.
    //
    // The numbers are measured, on five Anopheles gambiae poly(A) libraries of
    // 340-500 M read pairs against a 270 Mbp host (PRJNA970283): 6 h 16 m to
    // 11 h 40 m of wall clock, and 10-68 GB peak RSS. The spread tracks the
    // multi-mapping fraction rather than library size, because --very-sensitive
    // carries -k 50 and each multi-mapper is expanded up to fifty times before
    // `samtools view -F 256` throws the secondaries away. 32 GB would have been
    // less than half what the worst of those libraries needed, and 16 h left no
    // headroom over the slowest that finished.
    withName: 'HISAT2_ALIGN|HISAT2_ALIGN_SPLIT' {
        cpus   = { 12    * task.attempt }
        memory = { 96.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }

    // A chunk is a fresh HISAT2 process over --hisat2_chunk_size pairs, which is
    // the whole point: the memory that grows over a run is bounded by the chunk
    // rather than by the library. The default suits chunks of a few million
    // pairs; --hisat2_chunk_memory is the knob, because the ceiling scales with
    // the chunk size and not with anything the pipeline can infer.
    withName: '.*:(HISAT2_ALIGN_CHUNK|HISAT2_ALIGN_SPLIT_CHUNK)' {
        cpus   = { 12 }
        // Coerced, not used raw: --hisat2_chunk_memory is a string, and
        // multiplying a string by task.attempt concatenates it ('24.GB24.GB')
        // instead of doubling it, so the retry would fail to parse rather than
        // escalate.
        memory = { (params.hisat2_chunk_memory as nextflow.util.MemoryUnit) * task.attempt }
        time   = { 8.h * task.attempt }
    }

    // Counting records is a single decompression pass: I/O bound, one core.
    withName: 'HISAT2_CHUNKPLAN' {
        cpus   = { 2 }
        memory = { 4.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }

    // samtools cat plus two gzip concatenations - no decompression, no sort.
    withName: 'HISAT2_MERGECHUNKS' {
        cpus   = { 4 }
        memory = { 8.GB * task.attempt }
        time   = { 8.h  * task.attempt }
    }

    // Kraken2 loads the whole database into RAM, so `memory` must be at least
    // the database size (~8 GB for Standard-8, ~700 GB for core_nt). Set it
    // explicitly with --kraken2_memory; with --kraken2_memory_mapping the
    // database is mmap'ed from disk instead and this can be much smaller.
    // KRAKEN2_DAEMON is named here too, and it was not before. Its `label
    // 'process_high'` gave it 72 GB, so --kraken2_memory reached the ordinary
    // Kraken2 path and silently did nothing for the daemon one - a run that
    // asked for 400.GB against a 344 GB core_nt reserved 72.
    //
    // The resident index belongs to a background process that outlives the
    // task, so Nextflow cannot account for it however this is set. What the
    // request does is reserve headroom on the node, which is the whole point:
    // without it the local executor will start other large tasks alongside a
    // daemon that is holding a third of a terabyte. `maxForks 1` means the
    // reservation costs no parallelism.
    // The extra retry is for the daemon path. A `k2 classify --use-daemon`
    // call that finds no daemon on the other end of the control FIFO is killed
    // by the timeout in the module rather than hanging; the retry is what
    // clears the stale /tmp state and starts a fresh daemon, and with the
    // default single retry a genuinely slow attempt afterwards would end the
    // run. Two leaves one attempt after the reset.
    withName: 'KRAKEN2_KRAKEN2|KRAKEN2_SHUFFLED|KRAKEN2_DAEMON|KRAKEN2_DAEMON_SHUFFLED' {
        cpus       = { params.kraken2_cpus   ? params.kraken2_cpus as int : 12 }
        memory     = { params.kraken2_memory ?: (params.kraken2_memory_mapping ? 16.GB * task.attempt : 72.GB * task.attempt) }
        time       = { 12.h * task.attempt }
        maxRetries = 2
    }

    // PRISM runs Kraken2, then BLAST against nt, then STAR and minimap2, in one
    // task. The BLAST pass dominates and its cost tracks how many candidate
    // reads Kraken2 produced, not the library size.
    withName: 'PRISM_RUN' {
        cpus   = { 16 }
        memory = { 96.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }

    // PathSeq runs BWA against a microbe reference under Spark, so it is the
    // one classifier here whose cost tracks the library rather than the
    // database. The JVM is given the task's memory in the module itself.
    withName: 'GATK4_PATHSEQ' {
        cpus   = { 12 }
        memory = { 64.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    withName: 'GATK4_FASTQTOSAM' {
        cpus   = { 2 }
        memory = { 16.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    // The bootstrap loop is --sparcc_permutations SparCC runs, so this is the
    // one step here whose cost is set by a parameter rather than by the data.
    withName: 'SPARCC_CORRELATION' {
        cpus   = { 8 }
        memory = { 16.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withName: 'BRACKEN_BRACKEN' {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    // Qualimap holds the coverage arrays for a whole chromosome in the JVM heap,
    // and the module derives -Xmx from `memory`. 24 GB is comfortable for a
    // mammalian host; -nt above ~8 stops helping because the BAM reader is the
    // bottleneck.
    withName: 'QUALIMAP_BAMQC' {
        cpus   = { 8 }
        memory = { 24.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    // HUMAnN's translated search against UniRef is the most expensive step in
    // the pipeline by a wide margin, and it holds the pangenome index in RAM.
    withName: 'HUMANN3_HUMANN' {
        cpus   = { 12 }
        memory = { 48.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }

    withName: 'SUBREAD_FEATURECOUNTS' {
        cpus   = { 4 }
        memory = { 8.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }

    // Streams a FASTQ and shuffles a bounded sample of reads; cheap by design.
    withName: 'POLYA_CARRYOVER' {
        cpus   = { 1 }
        memory = { 2.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    // The AI steps do nothing but wait on HTTP, so they need no resources - but
    // `maxForks = 1` is load-bearing rather than a resource hint: it is what
    // stops N samples from firing N concurrent requests at a single LLM server.
    // Do not raise it without reading the serialisation note in
    // subworkflows/local/ai_annotate_reports/main.nf.
    //
    // The time limit is what actually bounds these: an unreachable endpoint is
    // retried by the script (3 attempts, 10 s + 30 s backoff) and then gives up,
    // so a task cannot hang beyond roughly n_calls * llm_timeout.
    withName: 'MULTIQC_AI|QUALIMAP_AI|LLM_INSIGHT' {
        cpus     = { 1 }
        memory   = { 2.GB * task.attempt }
        time     = { 12.h }
        maxForks = 1
    }

    // These two only ever ADD a box to a report that is already complete and
    // already published, so a flaky LLM must not take the run down with it.
    // MULTIQC_AI is deliberately excluded: with --multiqc_ai_builtin it is the
    // only process that publishes a MultiQC report, so losing it would lose the
    // report. It handles its own failures internally instead (see
    // bin/multiqc_ai.py, where the redaction sits in a `finally`).
    withName: 'QUALIMAP_AI|LLM_INSIGHT' {
        errorStrategy = 'ignore'
    }
}
