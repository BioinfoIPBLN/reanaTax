/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    BioinfoIPBLN/reanatax Nextflow base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 'blank slate' config file, appropriate for general use on most high performance
    compute environments. Assumes that all software is installed and available on
    the PATH. Runs in `local` mode - all jobs will be run on the logged in environment.
----------------------------------------------------------------------------------------
*/

process {

    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    // Process-specific resource requirements
    // NOTE - Please try and reuse the labels below as much as possible.
    //        These labels are used and recognised by default in DSL2 files hosted on nf-core/modules.
    //        If possible, it would be nice to keep the same label naming convention when
    //        adding in your local modules too.
    // See https://www.nextflow.io/docs/latest/config.html#config-process-selectors
    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }
    withLabel:process_long {
        time   = { 20.h  * task.attempt }
    }
    withLabel:process_low_memory {
        memory = { 1.GB * task.attempt }
    }
    withLabel:process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel:error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel:error_retry {
        errorStrategy = 'retry'
        maxRetries    = 2
    }
    withLabel: process_gpu {
        ext.use_gpu = { workflow.profile.contains('gpu') }
        accelerator = { workflow.profile.contains('gpu') ? 1 : null }
    }

    /*
    ------------------------------------------------------------------------
        Pipeline-specific overrides
    ------------------------------------------------------------------------
    */

    // Downloads are network-bound, not CPU-bound. One core each, capped so the
    // pipeline stays a well-behaved ENA/SRA client, and retried generously
    // because transient HTTP/FTP failures are the norm at scale.
    withName: 'FASTQDL|FASTQDL_METADATA' {
        cpus          = { 2 }
        memory        = { 2.GB * task.attempt }
        time          = { 8.h  * task.attempt }
        maxForks      = params.max_download_forks as int
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries    = 3
    }

    withName: 'NCBIGENOMEDOWNLOAD' {
        cpus          = { 2 }
        memory        = { 4.GB * task.attempt }
        time          = { 4.h  * task.attempt }
        errorStrategy = { task.attempt <= 3 ? 'retry' : 'finish' }
        maxRetries    = 3
    }

    // hisat2-build is the single most memory-hungry step when a splice-aware
    // index is requested (a vertebrate genome with --ss/--exon needs ~160-200 GB;
    // without them ~8 GB). params.hisat2_build_memory is the threshold the
    // module uses to decide which of the two it can afford.
    withName: 'HISAT2_BUILD' {
        cpus   = { 12 }
        memory = { params.gtf ? params.hisat2_build_memory : 24.GB * task.attempt }
        time   = { 24.h * task.attempt }
    }

    withName: 'HISAT2_ALIGN' {
        cpus   = { 12    * task.attempt }
        memory = { 32.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    // Kraken2 loads the whole database into RAM, so `memory` must be at least
    // the database size (~8 GB for Standard-8, ~700 GB for core_nt). Set it
    // explicitly with --kraken2_memory; with --kraken2_memory_mapping the
    // database is mmap'ed from disk instead and this can be much smaller.
    withName: 'KRAKEN2_KRAKEN2' {
        cpus   = { params.kraken2_cpus   ? params.kraken2_cpus as int : 12 }
        memory = { params.kraken2_memory ?: (params.kraken2_memory_mapping ? 16.GB * task.attempt : 72.GB * task.attempt) }
        time   = { 12.h * task.attempt }
    }

    withName: 'BRACKEN_BRACKEN' {
        cpus   = { 1 }
        memory = { 8.GB * task.attempt }
        time   = { 2.h  * task.attempt }
    }

    // Qualimap holds the coverage arrays for a whole chromosome in the JVM heap,
    // and the module derives -Xmx from `memory`. 24 GB is comfortable for a
    // mammalian host; -nt above ~8 stops helping because the BAM reader is the
    // bottleneck.
    withName: 'QUALIMAP_BAMQC' {
        cpus   = { 8 }
        memory = { 24.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }

    // The AI steps do nothing but wait on HTTP, so they need no resources - but
    // `maxForks = 1` is load-bearing rather than a resource hint: it is what
    // stops N samples from firing N concurrent requests at a single LLM server.
    // Do not raise it without reading the serialisation note in
    // subworkflows/local/ai_annotate_reports/main.nf.
    //
    // The time limit is what actually bounds these: an unreachable endpoint is
    // retried by the script (3 attempts, 10 s + 30 s backoff) and then gives up,
    // so a task cannot hang beyond roughly n_calls * llm_timeout.
    withName: 'MULTIQC_AI|QUALIMAP_AI|LLM_INSIGHT' {
        cpus     = { 1 }
        memory   = { 2.GB * task.attempt }
        time     = { 12.h }
        maxForks = 1
    }

    // These two only ever ADD a box to a report that is already complete and
    // already published, so a flaky LLM must not take the run down with it.
    // MULTIQC_AI is deliberately excluded: with --multiqc_ai_builtin it is the
    // only process that publishes a MultiQC report, so losing it would lose the
    // report. It handles its own failures internally instead (see
    // bin/multiqc_ai.py, where the redaction sits in a `finally`).
    withName: 'QUALIMAP_AI|LLM_INSIGHT' {
        errorStrategy = 'ignore'
    }
}
