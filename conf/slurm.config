/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for submitting every task to SLURM
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as follows:
        nextflow run BioinfoIPBLN/reanatax -profile slurm,singularity \
            --slurm_queue <partition> --outdir <OUTDIR> ...

    Each process becomes one `sbatch` job requesting exactly the cpus/memory/time
    of its resource label, so SLURM - not this pipeline - decides how many run at
    once. `--resource_limit_*` caps the request per job, which is what you want
    when a partition's nodes are smaller than the defaults in conf/base.config.
----------------------------------------------------------------------------------------
*/

process {
    executor = 'slurm'
    queue = params.slurm_queue ?: null
    clusterOptions = params.slurm_options ?: null

    // Cluster jobs die for reasons that have nothing to do with the pipeline
    // (preemption, node failure, a transient filesystem hiccup), so retry more
    // readily than the local default.
    maxRetries = 3
    errorStrategy = { task.exitStatus in ((130..145) + 104 + (175..177)) ? 'retry' : 'finish' }

    resourceLimits = [
        cpus: (params.resource_limit_cpus ?: 128) as int,
        memory: params.resource_limit_memory ?: '1000.GB',
        time: params.resource_limit_time ?: '240.h',
    ]

    // Downloads are network-bound and hold a job slot while doing nothing but
    // waiting on ENA, so keep them cheap.
    withName: 'FASTQDL|FASTQDL_METADATA|NCBIGENOMEDOWNLOAD' {
        // Many clusters firewall the compute nodes; --download_local moves just
        // these tasks back onto the submission host.
        executor = params.download_local ? 'local' : 'slurm'
    }
}

executor {
    $slurm {
        queueSize = params.slurm_queue_size as int
        // Bursting thousands of sbatch calls at once upsets most schedulers.
        submitRateLimit = '20/1min'
        pollInterval = '30 sec'
        exitReadTimeout = '5 min'
    }
    $local {
        // Only reached when --download_local is set.
        cpus = 4
        memory = '8.GB'
    }
}
