/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running everything on the current machine
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as follows:
        nextflow run BioinfoIPBLN/reanatax -profile local,singularity --outdir <OUTDIR> ...

    The CPU and memory ceilings are detected from the machine unless
    --resource_limit_cpus / --resource_limit_memory are given. Nextflow's local
    executor then schedules tasks so that the sum of the running tasks' `cpus`
    and `memory` requests never exceeds those ceilings - which is what keeps a
    memory-hungry step such as KRAKEN2 from being started several times at once.
----------------------------------------------------------------------------------------
*/

// Total RAM of this machine, in GB. /proc/meminfo is Linux-only, so fall back
// to the JVM's view (a fraction of the host) if it is unavailable. Held on a
// params key because Nextflow rejects `def` variables mixed with config
// statements in the same file.
params.detected_memory_gb = {
    try {
        ((new File('/proc/meminfo').readLines().find { line -> line.startsWith('MemTotal') }.replaceAll(/\D/, '') as long) / (1024 * 1024)) as int
    }
    catch (Exception _e) {
        null
    }
}()

process {
    executor = 'local'
    resourceLimits = [
        cpus: (params.resource_limit_cpus ?: Runtime.runtime.availableProcessors()) as int,
        memory: params.resource_limit_memory ?: (params.detected_memory_gb ? "${params.detected_memory_gb}.GB" : '128.GB'),
        time: params.resource_limit_time ?: '240.h',
    ]
}

executor {
    name = 'local'
    cpus = (params.resource_limit_cpus ?: Runtime.runtime.availableProcessors()) as int
    memory = params.resource_limit_memory ?: (params.detected_memory_gb ? "${params.detected_memory_gb}.GB" : '128.GB')
}
