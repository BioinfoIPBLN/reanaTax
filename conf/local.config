/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running everything on the current machine
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Use as follows:
        nextflow run BioinfoIPBLN/reanatax -profile local,singularity --outdir <OUTDIR> ...

    The CPU and memory ceilings are detected from the machine unless
    --resource_limit_cpus / --resource_limit_memory are given. Nextflow's local
    executor then schedules tasks so that the sum of the running tasks' `cpus`
    and `memory` requests never exceeds those ceilings - which is what keeps a
    memory-hungry step such as KRAKEN2 from being started several times at once.
----------------------------------------------------------------------------------------
*/

// Total RAM of this machine, in GB. /proc/meminfo is Linux-only, so fall back
// to the JVM's view (a fraction of the host) if it is unavailable.
def detected_memory_gb = {
    try {
        def kb = new File('/proc/meminfo').readLines().find { line -> line.startsWith('MemTotal') }.replaceAll(/\D/, '') as long
        return (kb / (1024 * 1024)) as int
    }
    catch (Exception _e) {
        return null
    }
}()

def limit_cpus = params.resource_limit_cpus ?: Runtime.runtime.availableProcessors()
def limit_memory = params.resource_limit_memory ?: (detected_memory_gb ? "${detected_memory_gb}.GB" : '128.GB')
def limit_time = params.resource_limit_time ?: '240.h'

process {
    executor = 'local'
    resourceLimits = [
        cpus: limit_cpus as int,
        memory: limit_memory,
        time: limit_time,
    ]
}

executor {
    name = 'local'
    cpus = limit_cpus as int
    memory = limit_memory
}
