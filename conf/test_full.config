/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running full-size tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a full size pipeline test.

    Use as follows:
        nextflow run BioinfoIPBLN/reanatax -profile test_full,<docker/singularity> \
            --kraken2_db /path/to/k2_standard --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

params {
    config_profile_name        = 'Full test profile'
    config_profile_description = 'Full test dataset to check pipeline function'

    // A small public human gut metagenome BioProject, fetched end to end.
    input_accessions           = 'PRJNA682076'
    group_runs_by              = 'experiment'

    // Deplete human reads before classification.
    host_accession             = 'GCF_000001405.40'
    ncbi_group                 = 'vertebrate_mammalian'

    // A real Kraken2 database is far too large to ship, so it has to be
    // supplied on the command line, e.g. --kraken2_db /data/k2_standard.
    bracken_read_length        = 100
}
