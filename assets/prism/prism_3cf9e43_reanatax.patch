+#' Species-level taxid for each BLAST taxid
+#'
+#' BLAST reports the taxid each subject sequence is labelled with, often a strain,
+#' serovar or subspecies. Rolled up to their species, a read hitting two strains of
+#' one species counts as unique to it, and its taxid is found in the Kraken2 report.
+#' Taxids with no species above them are kept as they are.
+#'
+#' @param taxids Character vector of taxids.
+#' @param nodes_path String. NCBI `nodes.dmp`, or `NA` to return `taxids` unchanged.
+
+prism_species_taxids <- function(taxids, nodes_path) {
+  if (is.na(nodes_path)) return(taxids)
+  nodes <- data.table::fread(nodes_path, sep = "\t", header = FALSE, select = c(1, 3, 5),
+                             colClasses = "character", quote = "")
+  setnames(nodes, c("taxid", "parent", "rank"))
+  up <- match(nodes$parent, nodes$taxid)
+  ids <- unique(taxids)
+  at <- match(ids, nodes$taxid)
+  species <- rep(NA_character_, length(ids))
+  repeat {
+    open <- which(!is.na(at) & is.na(species))
+    if (length(open) == 0) break
+    hit <- nodes$rank[at[open]] == "species"
+    species[open[hit]] <- nodes$taxid[at[open[hit]]]
+    climb <- open[!hit]
+    nxt <- up[at[climb]]
+    at[climb] <- ifelse(nxt == at[climb], NA_integer_, nxt)
+  }
+  species <- ifelse(is.na(species), ids, species)
+  species[match(taxids, ids)]
+}
+
