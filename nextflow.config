/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    BioinfoIPBLN/reanatax Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options - exactly one of these three routes must be given
    input                      = null       // samplesheet: sample,fastq_1,fastq_2
    input_dir                  = null       // folder holding already-downloaded FASTQ files
    input_accessions           = null       // ENA/SRA/BioProject accessions, or a file listing them
    fastq_pattern              = '**.{fastq,fq}{,.gz}'
    single_end                 = false      // skip mate detection in --input_dir and treat every file as single-end

    // Download options (--input_accessions)
    fastqdl_provider           = 'ena'
    // Runs to fetch from SRA regardless of --fastqdl_provider. fastq-dl's own
    // fallback only triggers when an accession is missing entirely, not when an
    // archive lists a file it then cannot serve - which is what ENA does often
    // enough to matter on a large cohort. Naming the run here moves that one
    // task only, so every other download keeps its cache entry.
    fastqdl_sra_runs           = null
    group_runs_by              = 'experiment'   // 'run', 'experiment' or 'sample'
    max_download_forks         = 4
    download_local             = false      // run downloads on the local executor even under -profile slurm
    save_download_metadata     = true

    // Host reference options. --host takes a comma-separated list of up to two
    // references, each independently an NCBI accession, a taxonomy ID, a genome
    // FASTA or a prebuilt HISAT2 index; what each entry is is detected from the
    // value. Reads are depleted against them in the order given (e.g. GRCh38
    // then T2T-CHM13), and the FIRST is the primary: --gtf describes it, and it
    // is the one QC'd and quantified.
    host                       = null       // e.g. 'GCF_000001405.40,/data/chm13.fa'
    gtf                        = null       // optional GTF: splice-aware index + --quantify_host

    // Superseded by --host, still accepted. Unlike --host these are grouped by
    // kind, so a mixed set is always ordered index, FASTA, accession, taxid.
    fasta                      = null       // host genome FASTA (optionally gzipped)
    hisat2_index               = null       // prebuilt HISAT2 index directory or .tar.gz
    host_accession             = null       // NCBI assembly accession, e.g. GCF_000001405.40
    host_taxid                 = null       // NCBI taxonomy ID, e.g. 9606
    ncbi_group                 = 'all'      // ncbi-genome-download taxonomic group to search
    ncbi_args                  = null       // extra ncbi-genome-download arguments
    hisat2_build_memory        = '200.GB'   // below this, the index is built without splice sites/exons
    save_reference             = true

    // Read QC and trimming options
    adapter_fasta              = null
    fastp_args                 = null
    // fastp's own low-complexity filter. Homopolymer and near-homopolymer
    // reads (poly-A tails, poly-G from two-colour chemistry) classify to
    // whatever genome happens to hold that run, which is how a low-complexity
    // artefact becomes a confident species call. SAHMI applies the same idea
    // at its own quantitation step (nFilter=130). Off by default: it removes
    // reads, and a read removed here is invisible to every count downstream.
    trim_low_complexity        = false
    low_complexity_threshold   = 30      // fastp's default: percent of bases differing from the next
    save_trimmed_fail          = false
    save_trimmed               = false

    // rRNA depletion (SortMeRNA). Off by default: it is the right step for a
    // total-RNA/RiboZero library, where rRNA is 94-99% of the reads, and pure
    // overhead for a poly(A)-selected or DNA library. Runs BEFORE host
    // depletion - see subworkflows/local/rrna_removal_sortmerna for why.
    remove_rrna                = false
    sortmerna_db               = null       // rRNA reference FASTA(s), comma-separated
    sortmerna_index            = null       // prebuilt index directory, or null to build one
    sortmerna_args             = null

    // Host depletion options
    hisat2_args                = '--very-sensitive'

    // Align this many read pairs per task instead of the library in one go.
    // HISAT2's memory grows with how much a single process has aligned - with
    // --very-sensitive, libraries of a few hundred million pairs have been seen
    // in the hundreds of GB - and only a fresh process resets it. Chunks are
    // offsets (`-s`/`-u`), not files: nothing is split or written to scratch,
    // and the chunks run in parallel. 0 disables it.
    hisat2_chunk_size          = 0
    hisat2_chunk_memory        = '24.GB'    // per chunk task; scale with --hisat2_chunk_size
    hisat2_max_alignments      = null       // appended as `-k <n>`; see docs/usage.md
    save_host_bam              = true
    save_unaligned             = true
    // Release a pair only when NEITHER mate aligned, instead of whenever the
    // pair failed to align concordantly. On by default: measured across four
    // vulvar-swab RNA libraries it took host carry-over from 0.5-13.5% to 0.0%
    // for a flat 2.7-3.6% loss of non-host reads. The two costs are not
    // equivalent - the loss is uniform across samples and leaves composition
    // untouched, while carry-over is sample-specific and biases comparisons
    // between them. Set false to get HISAT2's --un-conc-gz behaviour back.
    require_both_mates_unmapped = true

    // Strip synthetic sequence before classification. UniVec is NCBI's set of
    // vector, adapter, linker and primer sequences; reads from them are common
    // in real libraries and classify to whatever organism the vector was
    // derived from, which for most cloning vectors is E. coli or a coliphage.
    //
    // Its own pass rather than another --host entry, because a vector database
    // needs different alignment stringency: --very-sensitive expands to
    // `--score-min L,0,-1`, which lets a 100 bp read carry ~25 mismatches and
    // still align. Against a genome that catches diverged host sequence;
    // against a 3 kb plasmid backbone it deletes real reads. So this pass does
    // not inherit --hisat2_args.
    //
    // READ THE CAVEAT IN docs/usage.md BEFORE TURNING THIS ON: UniVec's
    // plasmid and phage backbones contain genuine E. coli and coliphage
    // sequence, so on a study where those organisms are the question, this
    // removes signal rather than noise.
    univec                     = false
    univec_source              = 'https://ftp.ncbi.nlm.nih.gov/pub/UniVec/UniVec_Core'
    univec_hisat2_args         = '--no-spliced-alignment --score-min L,0,-0.2'
    univec_save_bam            = false      // the vector alignments themselves

    // Storage. The work directory of a 180-library cohort reached 1.2 TB, of
    // which ~496 GB was alignments and ~413 GB FASTQ. These three knobs address
    // that; see docs/usage.md for what each is worth in practice.
    //
    // Applied wherever a tool writes a BGZF/gzip stream: `samtools -l`, `pigz
    // -N`, `fastp -z`. 9 buys roughly 5-10% on BAM for 2-3x the CPU, which is
    // rarely the right trade on a big cohort; 1 is worth considering for a run
    // whose intermediates are deleted anyway.
    //
    // null means "leave every tool at its own default", and that is not the
    // same as naming a number that happens to match one. A flag on the command
    // line changes the task hash, so a knob nobody asked for must not appear on
    // any command. It also avoids quietly moving fastp, whose own default is 4
    // rather than the 6 that samtools and zlib use.
    //
    // `ext.compression` in conf/modules.config is itself part of the hash
    // whatever its value, so the FIRST run on this pipeline version recomputes
    // the alignments once however this is set. Measured on the CSI-Microbes
    // plate: an otherwise fully cached resume re-ran 293 of 309 chunk tasks.
    compression_level          = null
    // 'cram' stores sorted host alignments against the reference instead of
    // storing the sequence, and is typically 40-60% smaller than BAM. It is
    // mutually exclusive with Qualimap, which reads `-bam` only and cannot open
    // a CRAM, so 'cram' requires --skip_qualimap and the pipeline refuses the
    // combination rather than failing halfway through.
    alignment_output_format    = 'bam'      // 'bam' or 'cram'
    // Delete intermediates as soon as the pipeline knows nothing else reads
    // them: per-chunk HISAT2 BAMs once their merge succeeds, and the downloaded
    // FASTQ once trimming and raw FastQC have both finished. Off by default,
    // because a deleted intermediate cannot be resumed - Nextflow will re-run
    // the task that produced it, and for the downloads that means fetching them
    // again. Turn it on for a run you are confident about.
    cleanup_intermediates      = false

    // Host BAM QC options (samtools stats/flagstat/idxstats always run with --save_host_bam)
    skip_qualimap              = false
    qualimap_gff               = null       // optional GFF/GTF for feature-level Qualimap stats
    qualimap_args              = null

    // Host gene quantification: turns the host half of the split into data
    quantify_host              = false      // featureCounts on the host BAM; requires --gtf
    featurecounts_args         = null
    featurecounts_feature_type = 'exon'
    featurecounts_attribute    = 'gene_id'

    // Taxonomic classification options
    kraken2_db                 = null       // Kraken2 database directory or .tar.gz
    kraken2_confidence         = 0.0
    kraken2_min_hit_groups     = 2
    kraken2_memory_mapping     = false
    // Classify through `k2 classify --use-daemon`: the index is loaded once
    // into a resident background process instead of once per sample. Worth it
    // as soon as the database is large and the cohort is more than one sample.
    kraken2_use_daemon         = false
    // Upper bound on a single `k2 classify --use-daemon` call. The daemon is
    // reached through FIFOs in /tmp and a client that opens them when nothing
    // is listening blocks in open(2) forever - no error, no CPU, and with
    // `maxForks 1` the whole cohort queues behind it. The local executor does
    // not enforce `time`, so this is what actually bounds the wait. Generous
    // enough to cover a cold index load (~30 min for core_nt) plus a large
    // library; raise it for droplet-scale runs.
    kraken2_daemon_timeout     = '3h'
    kraken2_report_minimizer_data = false
    kraken2_save_reads         = false
    kraken2_save_readclassifications = false
    kraken2_args               = null
    kraken2_cpus               = null       // overrides the process_high CPU count
    kraken2_memory             = null       // must be >= the database size unless memory-mapping;
                                            // applies to the daemon path too

    // MetaPhlAn: marker-gene profiling as an alternative (or a companion) to
    // Kraken2/Bracken. `--run_metaphlan --skip_kraken2` replaces Kraken2;
    // leaving Kraken2 on runs both over the same non-host reads.
    run_metaphlan              = false
    metaphlan_db               = null       // directory holding the index and its .pkl
    metaphlan_index            = null       // index basename, e.g. mpa_vJan25_CHOCOPhlAnSGB_202503
    metaphlan_args             = '-t rel_ab_w_read_stats'

    // sylph: species calls from containment ANI rather than from classifying
    // reads. Additive like MetaPhlAn; `--run_sylph --skip_kraken2` replaces
    // Kraken2, and adding `--skip_host_removal` skips alignment too. It assigns
    // no reads, so nothing per-read downstream can use it, and its detection
    // assumes reads that sample the whole genome - see docs/usage.md before
    // reading an absence on RNA as a negative.
    run_sylph                  = false
    sylph_db                   = null       // one or more .syldb/.syl2db databases, comma-separated
    sylph_taxonomy             = null       // sylph-tax metadata file(s) for those databases, comma-separated
    sylph_args                 = null       // passed to `sylph profile`, e.g. '-c 100' for a -c 100 database
    sylph_tax_args             = null       // passed to `sylph-tax taxprof`

    // Metax: species calls from reference alignment plus genome-wide coverage
    // evidence - a taxon whose reads pile onto one region is dropped. Additive
    // like sylph; `--run_metax --skip_kraken2` replaces Kraken2. It has no
    // public container, and its authors warn that coverage-based filtering can
    // drop true taxa in RNA-derived data - see docs/usage.md for both.
    run_metax                  = false
    metax_db                   = null       // a Metax database's metax_db.json, or the directory holding it
    metax_dmp_dir              = null       // NCBI taxonomy dump: nodes.dmp, names.dmp, merged.dmp, delnodes.dmp
    metax_args                 = null       // passed to `metax profile`, e.g. '--mode recall'
    metax_save_readclassifications = false  // publish Metax's per-read classify.txt, gzipped
    metax_container            = null       // an image providing metax and maCMD; none is public

    // KrakenUniq: a second classification route, with its OWN database (it
    // cannot read a Kraken2 index). Its report carries distinct-k-mer counts
    // and reference coverage per taxon, which discriminate spurious calls at
    // abundances where Kraken2's minimizer counts get too thin. Additive:
    // combine with --skip_kraken2 to use it instead of Kraken2.
    krakenuniq_db              = null       // KrakenUniq database directory
    krakenuniq_args            = null       // passed to the --preload invocation
    krakenuniq_classify_args   = null       // passed to each classification
    krakenuniq_save_reads      = false
    krakenuniq_save_readclassifications = false

    // GATK PathSeq: a third route, and the only one here that is not k-mer
    // based. It ALIGNS the surviving reads to a microbe reference with BWA and
    // divides an ambiguously mapping read between the taxa it hits, instead of
    // pushing it up to their common ancestor - so it can place at species level
    // what Kraken2 can only place at a genus, and it is not fooled by the
    // composition-driven chance matches --shuffle_control exists to measure.
    // Additive; combine with --skip_kraken2 to use it instead of Kraken2.
    //
    // Needs Broad's prebuilt resource bundle: this pipeline does not build the
    // index images, which are large, slow and specific to a reference choice.
    pathseq_microbe_bwa_image  = null       // microbe BWA index image (.img); enables the route
    pathseq_microbe_dict       = null       // its sequence dictionary (.dict)
    pathseq_taxonomy_db        = null       // PathSeq taxonomy database (.db)
    pathseq_host_bwa_image     = null       // optional host BWA image, for PathSeq's own host filter
    pathseq_host_kmers         = null       // ...and its host k-mer file; give both or neither
    pathseq_save_bam           = false      // the per-read BAM is the size of the library
    pathseq_rank               = 'species'  // PathSeq `type` kept in the combined tables (null = all)
    pathseq_args               = null

    // PRISM (sjdlabgroup/PRISM). Not a classifier: it takes candidate taxa and
    // tries to CONFIRM each one with independent evidence - full-length BLAST
    // against nt, the GenBank annotation those alignments land on, host mapping
    // with STAR and minimap2, and k-mer composition at every rank - and scores
    // it with an XGBoost model over forty features.
    //
    // Runs on the TRIMMED reads, not the non-host ones: it does its own host
    // removal, and several of its features are statistics of that removal.
    //
    // Not packaged anywhere. --prism_path must point at a prepared clone that
    // also holds `genbank/` (distributed separately by the authors) and
    // `sorted_accession_map.txt` (built once with blastdbcmd). Under docker or
    // singularity there is no public image, so --prism_container is required;
    // with -profile conda the environment.yml builds it.
    run_prism                  = false
    prism_path                 = null       // the prepared PRISM directory
    prism_container            = null       // your own image; required under docker/singularity
    prism_kraken_db            = null       // defaults to --kraken2_db
    prism_blast_db             = null       // BLAST nt database
    prism_star_genome_dir      = null       // host STAR index, for PRISM's own depletion
    prism_minimap2_index       = null       // host minimap2 index
    prism_min_qcovs            = 80         // PRISM's own defaults, made visible
    prism_min_read_per         = 10000
    prism_min_uniq_frac        = 5
    prism_max_sample           = 100
    // Read 1 is barcode+UMI with no biological sequence (10x and relatives).
    // Set this and the barcode read is DROPPED before PRISM sees it, so every
    // step - Kraken2 included - works on the cDNA read alone. Stricter than
    // PRISM's own --barcode_only, which only reaches its BLAST step; for that
    // literal behaviour leave this false and pass --prism_args '--barcode_only TRUE'.
    prism_barcode_only         = false
    prism_score_threshold      = 0.5        // median score below which a taxon is a contaminant
    prism_min_reads            = 10         // below this, PRISM has nothing to confirm either way
    // Apply PRISM's verdict to the combined Bracken table, as a second filter
    // pass. Off by default: PRISM scores the whole trimmed library while
    // Bracken profiles the non-host fraction, so the two agree on taxids but
    // were asked about slightly different read sets - worth looking at the
    // evidence table before letting it remove anything.
    prism_filter               = false
    prism_args                 = null

    bracken_db                 = null       // defaults to --kraken2_db
    bracken_read_length        = 'auto'     // 'auto' = measure from fastp, snap to a distribution in the DB
    bracken_level              = 'S'
    bracken_threshold          = 0

    // De novo assembly of the non-host fraction, for the one kind of evidence
    // every other filter here is blind to. Minimizer, host-k-mer, shuffle,
    // decontam and negative-control verdicts are all counts of a taxon's reads;
    // a contig is a longer SEQUENCE, and reads placed by index hopping or piled
    // on one conserved locus do not assemble into one. MEGAHIT and not an RNA
    // assembler on purpose - see modules/local/megahit. Pooled, because the
    // false positives this exists to catch sit at tens of reads per library.
    assembly                   = false
    assembly_assembler         = 'megahit'  // or 'metaspades' - better contigs, far more memory
    assembly_pool              = null       // 'all' | 'group' | 'sample'; null = group if --da_grouping, else all
    assembly_min_contig_len    = 300        // MEGAHIT's --min-contig-len
    assembly_args              = null
    // The verdict. Off by default: a contig is strong positive evidence, but
    // its absence is weak negative evidence - a genuinely rare organism does
    // not assemble either, which is what --contig_min_reads guards.
    contig_filter              = false
    contig_min_reads           = 50         // below this a taxon is recorded and not judged
    contig_min_length          = 500        // ...and needs a contig at least this long
    contig_min_contigs         = 1          // ...this many of them

    // BIOM export, purely for interoperability: nothing in this pipeline reads
    // it. The combined tables are already a taxa-by-sample matrix, so the
    // differential-abundance step skips the kraken-biom round trip DiffShot
    // does; this is here so a run can be handed to QIIME 2, phyloseq or
    // anything else that wants BIOM. Built from the same per-sample reports
    // Krona renders, then restricted to the taxa that survived the filters so
    // it agrees with the combined tables rather than contradicting them.
    export_biom                = false
    biom_metadata              = null       // TSV; defaults to --da_metadata

    // Differential abundance. Needs a metadata TSV (sample id in column 1, factor
    // columns after it) and a two-level contrast. Modelled on FGCZ's DiffShot
    // apps; both methods need integer counts, so they read the combined Bracken
    // table and not MetaPhlAn relative abundances.
    da_metadata                = null       // TSV: SampleID + factor columns
    da_method                  = 'ancombc'  // 'ancombc', 'aldex2', or both, comma-separated
    da_grouping                = null       // metadata column holding the contrast variable
    da_sample_group            = null       // value of da_grouping treated as the test group
    da_ref_group               = null       // value used as the reference level
    da_covariates              = null       // extra metadata columns, comma-separated
    da_prevalence_min          = 0.10       // keep taxa seen (>1 read) in this fraction of samples
    da_relabund_min            = 0.10       // ...and holding this percentage of the pooled reads
    da_lib_cut                 = 1000       // ANCOM-BC2 minimum library size
    da_p_threshold             = 0.05
    da_lfc_threshold           = 1.0
    da_samples_to_drop         = null       // comma-separated sample ids to exclude entirely

    // Host gene expression. --quantify_host counts host reads against the
    // annotation; these turn those counts into a matrix and test it between the
    // same two groups the microbial side is tested on. Negative binomial, not
    // compositional: gene counts have a scale that ALDEx2/ANCOM-BC2 are built to
    // discard. Runs when --quantify_host and the --da_* contrast are both given.
    host_de_method             = 'deseq2,edger'  // 'deseq2', 'edger', both, or null to skip
    host_de_min_count          = 10         // a gene needs this many reads...
    host_de_min_samples        = 2          // ...in at least this many samples
    // Host expression against microbial abundance (Monteleone's third layer).
    // Opt-in: with few samples no gene x taxon pair can reach significance and
    // the script refuses rather than returning a misleading empty table.
    host_microbe_correlation   = false
    host_microbe_top_genes     = 2000       // most variable genes to test (0 = all)
    host_microbe_top_taxa      = 50         // most abundant taxa to test (0 = all)

    // Targeted taxon: pull one organism's reads back out of the classification
    // and follow them to differential expression of its own genes. Needs
    // --kraken2_save_readclassifications, since that is the record of which read
    // went where.
    target_taxid               = null       // taxon to extract; enables the branch
    target_reference           = null       // its genome: accession, taxid, FASTA or HISAT2 index
    target_gtf                 = null       // its annotation; without it the branch stops at the BAM
    target_include_children    = true       // also take reads assigned below the taxon
    target_include_parents     = false      // ...and above it (a genus read is not species evidence)
    target_max_reads           = 100000000  // KrakenTools' own cap, made explicit
    target_de_method           = 'deseq2,edger'

    // Pseudoalignment quantification. Where a transcriptome is given, kallisto
    // replaces align-then-count: --host_transcripts quantifies host expression
    // straight from the trimmed reads, --target_transcripts quantifies the
    // extracted taxon without needing its genome or GTF at all.
    //
    // Deliberately NOT offered for host depletion: a transcriptome index can
    // only remove reads that came from an annotated transcript, so intronic,
    // intergenic, repeat and satellite reads would survive and be classified as
    // spurious microbes - the very reads the second host assembly exists to
    // catch.
    host_transcripts           = null       // host transcriptome FASTA
    host_tx2gene               = null       // two-column transcript->gene TSV
    target_transcripts         = null       // target taxon transcriptome FASTA
    target_tx2gene             = null
    kallisto_args              = null
    kallisto_fragment_length   = 200        // single-end only; kallisto cannot infer it
    kallisto_fragment_sd       = 30

    // Minimizer-evidence filter. Asks whether a taxon's reads cover BREADTH of
    // its reference or pile onto one locus - the thing an abundance threshold
    // cannot see. Reads Kraken2's --report-minimizer-data columns, or
    // KrakenUniq's kmers/dup/cov, and removes what fails from the combined
    // tables (the removed rows are written out, as always).
    minimizer_filter           = false
    minimizer_min_reads        = 50      // below this a taxon is not judged at all
    minimizer_min_distinct     = 10      // ...must cover at least this many distinct minimizers/k-mers
    // Sun et al.'s F1-optimised sweep puts the optimum near 1000 unique k-mers,
    // and Kraken2 minimizers need 2-3x MORE than KrakenUniq k-mers for equal
    // F1 - so ~2000-3000. The default above is far below that and is left
    // conservative deliberately; setting a scale is the better fix, because the
    // optimum tracks depth (~0.002 unique k-mers per read) and public datasets
    // differ 100-fold in depth. Effective threshold = max(min_distinct, scale x
    // classified reads). 0 disables.
    minimizer_distinct_scale   = 0
    minimizer_max_duplication  = 100     // ...with observed/distinct no higher than this
    minimizer_min_coverage     = 0       // ...and this fraction of its reference (0 = off)
    // SAHMI's sample-level test, on top of the thresholds above: a taxon's
    // reads, k-mers and distinct k-mers must rise together across samples.
    // Needs >=5 samples - below that the smallest attainable Spearman p is
    // 2/n!, which cannot clear 0.05.
    minimizer_correlation      = false
    minimizer_correlation_p    = 0.05    // BH-adjusted, and all three must clear it

    // SAHMI's per-read host test: drop taxa whose reads mostly carry host
    // k-mers, whatever the reads themselves were classified as. Needs
    // --kraken2_save_readclassifications and the host to be in the database.
    host_kmer_filter           = false
    host_kmer_taxid            = null    // defaults to --host_carryover_taxid
    host_kmer_max_fraction     = 0.5     // drop once this share of a taxon's reads are tainted
    host_kmer_min_reads        = 10      // below this, leave the taxon to the abundance filter

    // decontam: the only filter here given an external measurement of the kit,
    // and so the only one that can tell a reagent contaminant from a rare
    // organism. Needs blanks (prevalence) or post-PCR DNA concentrations
    // (frequency), which most public datasets have neither of - hence opt-in.
    decontam                   = false
    decontam_metadata          = null       // TSV; defaults to --da_metadata
    decontam_neg_column        = null       // metadata column marking negative controls
    decontam_neg_value         = 'true'     // ...and the value that marks one
    decontam_conc_column       = null       // DNA concentration column, for the frequency method
    decontam_method            = 'prevalence'  // prevalence|frequency|combined|either|minimum
    decontam_threshold         = 0.1        // decontam's own default
    // Contamination is a property of the kit, not of the study: pool two
    // sequencing runs or two extraction days and a taxon heavy in one and
    // absent from the other looks exactly like a real organism that varies
    // between samples. Naming the column that separates the runs scores each
    // batch against its OWN blanks and combines the verdicts.
    decontam_batch_column      = null       // metadata column grouping samples into batches
    decontam_batch_combine     = 'minimum'  // minimum|product|fisher; 'minimum' = flagged anywhere is flagged

    // Negative-control libraries: blanks, empty wells, no-template controls.
    //
    // The only filter here whose verdict is per LIBRARY rather than per taxon,
    // and the only one that can address well-to-well carryover and index
    // hopping at all. Those put GENUINE reads of a GENUINE organism into the
    // wrong library, so nothing about the reads is wrong and no evidence
    // filter can see them; and the same taxon is then signal in one library
    // and carryover in the next, which no single verdict per taxon can say.
    // Failing cells are zeroed in place; taxa that fail everywhere leave by
    // the usual taxid list. Read bin/control_filter.py before setting these -
    // the recall cost is real and it is stated there with numbers.
    //
    // Four accepted forms: a comma-separated list of sample IDs, a file of one
    // ID per line, 'metadata.tsv:column', or 'metadata.tsv:column:value'.
    negative_controls          = null
    control_ratio              = 10      // multiple of the control level a taxon must reach
    control_statistic          = 'mean'  // mean|median|max of the controls; 'max' is the strict read
    control_min_reads          = 2       // ...and this many reads, before the ratio is consulted
    // Absence from the blanks is a BOUND, not a measurement: it says the taxon
    // is under one read in each of them, not that it is at zero. Without a
    // floor the ratio test collapses to "any reads at all" for every taxon the
    // controls happened to miss, which on a species table is most of them.
    control_floor_reads        = 1       // the control level never falls below this many reads

    // The no-controls fallback, and a much cruder question: is this taxon in
    // EVERY library? A reagent contaminant introduced at extraction is; a
    // biological signal usually is not. Only sound where a universally present
    // taxon CANNOT be real - it is wrong for a mono-culture, wrong for a
    // dominant commensal - so it is off by default. As a fraction of
    // libraries: 1.0 = present in every one.
    prevalence_filter          = 0
    prevalence_min_reads       = 1       // reads in a library for it to count as present

    // Shuffled-read negative control. Classifies every library twice: once as
    // sequenced, and once with each read shuffled so that its length, GC
    // content and dinucleotide frequencies survive and none of its k-mers do.
    // Whatever the database still reports is what it produces from base
    // composition alone, which is the one number none of the other filters can
    // supply - they all judge a taxon's evidence on its own terms, with no
    // measurement of what that evidence is worth against noise.
    //
    // Costs a second Kraken2 pass over the same reads (nothing else re-runs),
    // so it is opt-in; with --kraken2_use_daemon the database is already
    // resident and the second pass is close to free.
    shuffle_control            = false
    shuffle_method             = 'dinuc'    // dinuc|mono|reverse - see bin/shuffle_reads.py
    shuffle_seed               = 1          // fixed: a control that moves between runs is not one
    shuffle_reads              = 0          // shuffle only the first N fragments per sample (0 = all)
    shuffle_max_ratio          = 0.1        // flag a taxon once shuffled/real reaches this
    shuffle_min_reads          = 10         // below this many real reads a taxon is left untested

    // Which taxa travel together: a co-occurrence network over the cohort,
    // inferred by SparCC (FastSpar's implementation). An ordinary correlation
    // matrix on compositional data manufactures negative associations
    // everywhere, because the counts sum to a library size with no biological
    // meaning; SparCC works on log-ratio variances, which are invariant to it.
    //
    // Refused outright on a small cohort rather than run to an empty answer: an
    // empty network from ten pairs and five samples means "this cohort cannot be
    // asked", which is a different statement from "there are no associations".
    run_sparcc                 = false
    sparcc_min_prevalence      = 0.5     // a taxon must be seen in this share of samples...
    sparcc_min_reads           = 10      // ...with at least this many reads there
    sparcc_top_taxa            = 200     // most abundant survivors kept (0 = all)
    sparcc_iterations          = 50      // SparCC's own iterations for the point estimate
    sparcc_exclusion_iterations = 10     // ...and its strongly-correlated-pair exclusions
    sparcc_permutations        = 1000    // bootstrap replicates behind the p-values
    sparcc_min_correlation     = 0.3     // |rho| an edge needs before it is reported
    sparcc_p_threshold         = 0.05    // on the BH-adjusted p, across every pair at once
    sparcc_force               = false   // run even when the cohort cannot support it

    // Alpha diversity, and how much of the between-sample variation each
    // metadata variable explains (Aitchison + dbRDA, after Llorens-Rico 2021).
    run_diversity              = false
    diversity_metadata         = null       // TSV; defaults to --da_metadata
    diversity_permutations     = 999

    // ---- single-cell branch -------------------------------------------
    // scRNA-seq needs a barcode-aware host aligner, because in single cell the
    // host reads are the OTHER HALF of the experiment (the cell-by-gene matrix)
    // and the cell barcode is the only thing joining them to the microbial
    // reads. HISAT2 is barcode-blind, so this route uses STARsolo instead of
    // HOST_DEPLETION_HISAT2 rather than in addition to it.
    single_cell                = false
    star_index                 = null       // prebuilt STAR index dir or tarball
    sc_chemistry               = '10xv3'    // 10xv2|10xv3|10xv4|custom
    sc_whitelist               = null       // barcode whitelist, or 'None' to disable correction
    sc_cb_len                  = null       // custom chemistry only; otherwise from the preset
    sc_umi_start               = null
    sc_umi_len                 = null
    sc_solo_type               = 'CB_UMI_Simple'
    sc_solo_features           = 'Gene'
    sc_cell_filter             = 'EmptyDrops_CR'
    sc_star_args               = null       // extra STARsolo arguments
    // Read-level filters on the microbial side, from SAHMI's sckmer.r
    sc_min_frac                = 0.5        // share of a read's k-mers inside the taxon's lineage
    sc_max_homopolymer         = 0          // drop reads with a longer single-base run (0 = off)
    sc_ranks                   = 'S,G'      // ranks to tabulate the cell x taxon matrix at
    sc_host_taxid              = null       // defaults to --host_kmer_taxid / --host_carryover_taxid
    sc_umi_dedup               = true       // count distinct UMIs, not reads
    // CSI-Microbes' presence rule: a taxon is present in a cell only with at
    // least this many UMIs. On their positive control >=2 removed 100% of
    // contaminant genera - a stronger result than any correlation test here.
    // They call it arbitrary themselves, so a 1..5 sweep is always written.
    sc_min_umis                = 2
    // SAHMI's barcode-level denoising: a taxon's total and DISTINCT k-mers must
    // rise together across cells. Much more powerful than the sample-level
    // version, because a library has thousands of barcodes but few samples.
    sc_kmer_denoise            = true
    sc_kmer_len                = 35         // Kraken2's k; 35 for the standard databases
    sc_min_barcodes            = 4          // SAHMI tests taxa seen on more than three barcodes
    sc_correlation_p           = 0.05       // adjusted p
    sc_adjust                  = 'holm'     // SAHMI uses R's p.adjust default (holm, FWER)
    sc_max_barcodes_per_taxon  = 1000       // SAHMI's nsample; 0 removes the cap
    // Cell association against the ambient pool. An ANNOTATION, not a filter:
    // an empty droplet holds reagent contaminants, ambient soup, microbes from
    // lysed cells AND genuine extracellular organisms from the tissue, and no
    // droplet-level comparison separates them. A taxon as common in the medium
    // as in the cells is therefore reported as UNDECIDED rather than as
    // contamination - only --decontam's blanks settle that. What this does
    // answer is whether a taxon is where the cells are, which is the strongest
    // evidence droplet data can offer for an intracellular organism.
    //
    // Needs STARsolo's raw/ matrix as well as filtered/, so it is incompatible
    // with --sc_cell_filter None.
    sc_ambient                 = false
    sc_ambient_min_empty_umis  = 1       // host UMIs an empty droplet needs to be used...
    sc_ambient_max_empty_umis  = 0       // ...and at most this many (0 = no upper bound)
    sc_ambient_min_droplets    = 5       // droplets a taxon must appear in to be tested
    sc_ambient_enriched_ratio  = 2.0     // prevalence ratio for 'cell_associated'
    sc_ambient_depleted_ratio  = 0.5     // ...and for 'cell_depleted'
    // Remove the ambient and cell-depleted taxa. ONLY correct when the question
    // is about INTRACELLULAR microbes: an extracellular organism genuinely
    // present in the tissue is ambient by construction and is on that list.
    sc_ambient_drop            = false

    // SAHMI's host half: what a cell's own transcriptome does when it is
    // carrying something. Infected cells against bystander cells OF THE SAME
    // TYPE, Wilcoxon on log-normalised counts - Seurat's FindMarkers defaults,
    // which is what SAHMI calls. Needs --sc_cell_metadata: which cell types
    // carry a taxon is itself a result, so a pooled test would report the
    // difference between cell types as a response to infection.
    sc_host_de                 = false
    sc_host_de_min_cells       = 10         // infected AND bystander cells a group needs
    sc_host_de_min_pct         = 0.1        // a gene must be detected in this share of one side
    sc_host_de_logfc           = 0.25       // Seurat's logfc.threshold, on log2
    sc_host_de_top_taxa        = 20         // most-infecting taxa to test (0 = all)
    sc_host_de_force_pooled    = false      // run without cell types anyway; every row says so

    // Plate-based single cell (Smart-seq2 and relatives), CSI-Microbes' second
    // route. Every well is its own library, so there is no barcode, no
    // STARsolo and no --single_cell: each cell runs the ordinary bulk route and
    // the cell-by-taxon matrix is those per-cell reports stacked. The cohort is
    // then one cell per samplesheet row, and --sc_cell_metadata must name the
    // patient/plate each cell came from as well as its type.
    sc_plate_based             = false
    sc_plate_min_reads         = 10         // reads of a taxon before a cell carries it
    // Deliberately not --sc_min_umis: Smart-seq2 has no UMIs, and one amplified
    // cDNA molecule can be hundreds of reads, so the two thresholds are not
    // interchangeable and the read one has to be stricter.

    // Cell-type enrichment (CSI-Microbes' statistics). Needs cell-type calls,
    // which this pipeline cannot produce - STARsolo gives a matrix, not
    // clusters - so it is skipped unless the annotations are supplied.
    sc_cell_metadata           = null       // TSV: barcode, sample, cell_type[, host_umis]
    // Apply the evidence filters' drop lists to the cell-by-taxon matrix, not
    // only to the cohort tables. On by default: a taxon the pipeline has judged
    // false should not go on costing the enrichment test multiple-testing
    // power. Turn it off to see the unfiltered matrix.
    sc_apply_drop_list         = true
    sc_cooccurrence_min_cells  = 10         // a taxon must infect this many cells to be paired
    sc_enrichment_p            = 0.05

    // Sparse-taxon filter applied to the combined tables (not a decontaminator)
    min_rel_abundance          = 0.001      // must exceed 0.1% relative abundance...
    min_samples                = 1          // ...in at least this many samples
    // AND an absolute floor. The relative threshold is computed against the
    // MICROBIAL total, which after host depletion is small, so 0.1% of it can
    // be three reads on one locus. Gihawi et al. (mBio 2023) use >=10; PRISM
    // will not attempt confirmation below 10 and calls its score reliable only
    // above ~100. 0 disables, which is the previous behaviour.
    min_reads                  = 0

    // Functional profiling (opt-in; databases are user-provided and large)
    run_humann                 = false
    humann_nucleotide_db       = null       // ChocoPhlAn directory
    humann_protein_db          = null       // UniRef (translated search) directory
    humann_utility_db          = null       // utility mapping directory, needed for --humann_regroup
    humann_regroup             = 'uniref90_ko'  // regroup gene families onto KEGG orthologs
    humann_renorm              = 'cpm'      // 'cpm', 'relab' or null
    humann_args                = null

    // Breadth of a taxon's evidence across its own genome (PRISM's argument).
    // Every other filter counts reads, or the k-mers behind reads; none can see
    // WHERE those reads landed, and a thousand reads on one conserved gene
    // passes all of them. HUMAnN's species-stratified gene-family table answers
    // it directly, so this needs --run_humann and no new reference. With
    // --humann_regroup set it runs a second time on the regrouped table, which
    // is the difference between many gene families and many PRODUCTS.
    gene_diversity_filter      = false
    gene_diversity_min_families = 10     // distinct gene families a taxon must reach...
    gene_diversity_max_top_fraction = 0.5 // ...with no single family carrying more than this
    gene_diversity_min_abundance = 0     // below this pooled abundance, leave the taxon untested

    // Drop the host taxon from the combined tables and renormalise, so microbial
    // abundances are fractions of the microbial reads rather than of everything
    // that survived depletion. The unfiltered tables are published either way.
    drop_host_taxon            = false
    // Host leakage does not stop at the host's own taxid. A host read that
    // misses the host genome is assigned to the nearest relative the database
    // holds, so it arrives wearing a sibling's name: on the CSI-Microbes 10x
    // cohort, with Homo sapiens already dropped, Pan/Pongo/Gorilla/Macaca/Tupaia
    // were still 84% of everything called microbial in the uninfected library.
    // genus|family|order|class|phylum, resolved against the run's own reports.
    // Nothing below family is worth setting for a human host - Homo has no other
    // species in most databases, so 'genus' removes ~0.1%. High ranks are
    // destructive by design: 'class' on a xenograft deletes the mouse.
    drop_host_clade            = null

    // Package the taxonomic tables for the exploreMetaTax Shiny app, renamed so
    // its folder upload recognises them. https://shiny-public.fgcz.uzh.ch/app/exploreMetaTax
    exploremetatax_bundle      = false

    // Read accounting and diagnostics
    skip_read_accounting       = false
    host_carryover_taxid       = 9606       // taxon counted as host leakage in the Kraken2 report
    run_polya_check            = false      // poly(A) carry-over diagnostic; poly(A) libraries only
    polya_args                 = null

    // AI annotation options. Entirely opt-in: with `llm_endpoint` unset (the
    // default) the pipeline never contacts any LLM service.
    llm_endpoint               = null       // OpenAI-compatible /v1/chat/completions URL
    llm_model                  = null       // model name served at that endpoint
    llm_api_key                = 'dummy'    // Bearer token; 'dummy' for servers that ignore it
    llm_context_window         = 128000
    llm_timeout                = 300        // seconds per response
    ai_insights                = 'all'      // 'all', 'no', or a comma list of multiqc,qualimap,taxonomy
    multiqc_ai_builtin         = false      // also use MultiQC's own AI summary feature
    multiqc_ai_summary         = 'full'     // 'full' or 'short' (--multiqc_ai_builtin only)
    ai_qualimap_sections       = false      // one extra LLM call per Qualimap plot per sample

    // Steps to skip
    skip_fastqc                = false
    skip_trimming              = false
    skip_host_removal          = false
    skip_kraken2               = false
    skip_bracken               = false
    skip_krona                 = false
    skip_multiqc               = false

    // Resource limits, applied by the `local` and `slurm` profiles
    resource_limit_cpus        = null
    resource_limit_memory      = null
    resource_limit_time        = null

    // SLURM options, only used by `-profile slurm`
    slurm_queue                = null
    slurm_options              = null
    slurm_queue_size           = 100

    // MultiQC options
    multiqc_config             = null
    multiqc_title              = null
    multiqc_logo               = null
    max_multiqc_email_size     = '25.MB'
    multiqc_methods_description = null

    // Boilerplate options
    outdir                       = null
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/'
    trace_report_suffix          = new java.util.Date().format( 'yyyy-MM-dd_HH-mm-ss')

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'


profiles {
    debug {
        dumpHashes              = true
        // Keeps the base config's `mkdir -p tmp`; a bare override would leave
        // every task without the TMPDIR that env.TMPDIR points at.
        process.beforeScript    = 'mkdir -p tmp; echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    // Companion to --kraken2_use_daemon; use as `-profile local,singularity,k2daemon`.
    //
    // Nextflow gives every task its own PID namespace (`--pid`). That is sound
    // isolation, and it is fatal to `k2 classify --use-daemon`. The daemon
    // writes a namespace-local PID into the shared /tmp/classify.pid - 14, 137,
    // 2343, never a host PID - so the next task's liveness check, `ps <pid>`,
    // asks about a number that means nothing in its own namespace and always
    // concludes the daemon is dead. Worse, the namespace is torn down when the
    // task ends, which kills the daemon whatever the PID file says. Measured on
    // the CSI plate cohort: 277 tasks, 277 daemon starts, 0 reuses - the daemon
    // reloaded the whole index every single time. Sharing the host PID
    // namespace fixes both halves.
    //
    // It is a separate profile rather than `!params.kraken2_use_daemon` because
    // a param read at config-evaluation time may not yet carry a value given on
    // the command line, and this setting failing silently is indistinguishable
    // from the bug it fixes. A profile can be verified with `nextflow config`.
    //
    // Cost: a killed task can orphan processes instead of having them reaped
    // with its namespace, and the daemon now outlives the run - so the
    // `k2 clean --stop-daemon` warning the pipeline prints stops being advisory.
    k2daemon {
        singularity.newPidNamespace = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    local     { includeConfig 'conf/local.config'     }
    slurm     { includeConfig 'conf/slurm.config'     }
    test      { includeConfig 'conf/test.config'      }
    test_accession { includeConfig 'conf/test_accession.config' }
    test_full { includeConfig 'conf/test_full.config' }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load BioinfoIPBLN/reanatax custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"


// A pipeline-specific nf-core config can be added at https://github.com/nf-core/configs
// and then enabled by uncommenting the line below.
// includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/pipeline/reanatax.config" : "/dev/null"

// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    // MultiQC's own AI feature (--multiqc_ai_builtin) reads the key for its
    // `custom` provider from OPENAI_API_KEY and offers no CLI flag for it.
    // Nextflow's env scope is the only route into a container here: nxf_launch
    // wipes the environment with `env -` and rebuilds it from this scope, so a
    // beforeScript export would never arrive.
    OPENAI_API_KEY   = params.multiqc_ai_builtin ? params.llm_api_key : 'unused'
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
    // Nextflow launches Singularity/Apptainer with --no-home, so $HOME points at
    // a path that is not mounted and cannot be created: the container root is
    // read-only. Any tool that caches under $HOME then dies on `mkdir` -
    // ncbi-genome-download does exactly this before it fetches
    // assembly_summary.txt. These are relative on purpose: every task runs with
    // its work directory as the cwd, so the cache is writable, task-local, and
    // free of races between concurrent tasks.
    HOME             = "."
    XDG_CACHE_HOME   = "./.cache"
    // Same reasoning, for anything that writes scratch files: samtools sort,
    // STAR, sortmerna, the JVM, python's tempfile. Relative, so it resolves to
    // the task work directory; conf/base.config creates it in beforeScript.
    // k2's daemon is the deliberate exception - it hardcodes /tmp in its source
    // and is meant to be reachable across tasks, so it is left there.
    TMPDIR           = "./tmp"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'BioinfoIPBLN/reanatax'
    contributors    = [
        [
            name: 'Jose L. Ruiz',
            affiliation: 'Functional Genomics Center Zurich (FGCZ), University of Zurich / ETH Zurich',
            email: 'jose.ruizrodriguez@fgcz.uzh.ch',
            github: 'josruirod',
            contribution: ['author', 'maintainer'],
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/BioinfoIPBLN/reanatax'
    description     = """Taxonomic profiling of the non-host fraction of public or local sequencing data - fetch, QC, host depletion with HISAT2, and Kraken2/Bracken classification."""
    mainScript      = 'main.nf'
    defaultBranch   = 'master'
    nextflowVersion = '!>=25.10.4'
    version         = '1.0.0dev'
    doi             = ''
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.5.1' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"]
    monochromeLogs = params.monochrome_logs
    summary {
        // The parameter summary is printed to the log AND embedded in the
        // MultiQC report, which is a shareable HTML file. The LLM endpoint and
        // API key are deployment secrets, so they must never reach it. This is
        // the first line of defence; MULTIQC_AI scrubs the report as a second.
        hideParams = ["llm_endpoint", "llm_api_key"]
    }
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
